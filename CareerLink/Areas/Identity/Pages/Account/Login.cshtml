@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="cl-auth-page">
    <div class="cl-auth-card">

        <div class="cl-auth-brand">
            <div class="cl-auth-logo">
                <span>CL</span>
            </div>

            <div>
                <div class="cl-auth-brand-name">CareerLink</div>
                <div class="cl-auth-brand-tagline">Connect. Discover. Grow.</div>
            </div>
        </div>

        <div class="cl-auth-heading">
            <h1>Welcome back</h1>
            <p>Log in to continue to your CareerLink account.</p>
        </div>

        <form id="account" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="cl-auth-validation"
                 role="alert">
            </div>

            <div class="cl-auth-field">
                <label asp-for="Input.Email">Email address</label>

                <input asp-for="Input.Email"
                       class="cl-auth-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

                <span asp-validation-for="Input.Email"
                      class="cl-auth-error">
                </span>
            </div>

            <div class="cl-auth-field">
                <div class="cl-auth-label-row">
                    <label asp-for="Input.Password">Password</label>

                    <a id="forgot-password"
                       asp-page="./ForgotPassword"
                       class="cl-auth-forgot">
                        Forgot password?
                    </a>
                </div>

                <input asp-for="Input.Password"
                       class="cl-auth-input"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Enter your password" />

                <span asp-validation-for="Input.Password"
                      class="cl-auth-error">
                </span>
            </div>

            <div class="cl-auth-remember">
                <label asp-for="Input.RememberMe">
                    <input class="form-check-input"
                           asp-for="Input.RememberMe" />

                    <span>Remember me</span>
                </label>
            </div>

            <button id="login-submit"
                    type="submit"
                    class="cl-auth-submit">
                Log in
            </button>

        </form>

        <div class="cl-auth-divider">
            <span>or</span>
        </div>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div class="cl-auth-no-external">
                    <p>
                        Sign in using your CareerLink account.
                    </p>
                </div>
            }
            else
            {
                <form id="external-account"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">

                    <div class="cl-auth-external-buttons">

                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="cl-auth-external-button"
                                    name="provider"
                                    value="@provider.Name"
                                    title="Log in using your @provider.DisplayName account">

                                Continue with @provider.DisplayName

                            </button>
                        }

                    </div>

                </form>
            }
        }

        <div class="cl-auth-footer">
            <span>Don't have an account?</span>

            <a asp-page="./Register"
               asp-route-returnUrl="@Model.ReturnUrl">
                Create an account
            </a>
        </div>

        <div class="cl-auth-resend">
            <a id="resend-confirmation"
               asp-page="./ResendEmailConfirmation">
                Resend email confirmation
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}