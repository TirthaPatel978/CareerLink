@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="cl-auth-page">
    <div class="cl-auth-card cl-auth-card-register">

        <div class="cl-auth-brand">
            <div class="cl-auth-logo">
                <span>CL</span>
            </div>

            <div>
                <div class="cl-auth-brand-name">CareerLink</div>
                <div class="cl-auth-brand-tagline">Connect. Discover. Grow.</div>
            </div>
        </div>

        <div class="cl-auth-heading">
            <h1>Create your account</h1>
            <p>Join CareerLink and take the next step in your career.</p>
        </div>

        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="cl-auth-validation"
                 role="alert">
            </div>

            <div class="cl-auth-field">
                <label asp-for="Input.Email">Email address</label>

                <input asp-for="Input.Email"
                       class="cl-auth-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

                <span asp-validation-for="Input.Email"
                      class="cl-auth-error">
                </span>
            </div>

            <div class="cl-auth-field">
                <label asp-for="Input.Password">Password</label>

                <input asp-for="Input.Password"
                       class="cl-auth-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Create a password" />

                <span asp-validation-for="Input.Password"
                      class="cl-auth-error">
                </span>
            </div>

            <div class="cl-auth-field">
                <label asp-for="Input.ConfirmPassword">
                    Confirm password
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="cl-auth-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Re-enter your password" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="cl-auth-error">
                </span>
            </div>

            <div class="cl-auth-field">
                <label asp-for="AccountType">
                    Account type
                </label>

                <select asp-for="AccountType"
                        class="cl-auth-input cl-auth-select">

                    <option value="JobSeeker">
                        Job Seeker
                    </option>

                    <option value="Recruiter">
                        Recruiter
                    </option>

                </select>

                <span asp-validation-for="AccountType"
                      class="cl-auth-error">
                </span>

                <small class="cl-auth-help">
                    Choose the type of CareerLink account you want to create.
                </small>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="cl-auth-submit">
                Create account
            </button>

        </form>

        <div class="cl-auth-divider">
            <span>or</span>
        </div>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div class="cl-auth-no-external">
                    <p>
                        You can create your account using your email address.
                    </p>
                </div>
            }
            else
            {
                <form id="external-account"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">

                    <div class="cl-auth-external-buttons">

                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="cl-auth-external-button"
                                    name="provider"
                                    value="@provider.Name"
                                    title="Register using your @provider.DisplayName account">

                                Continue with @provider.DisplayName

                            </button>
                        }

                    </div>

                </form>
            }
        }

        <div class="cl-auth-footer">
            <span>Already have an account?</span>

            <a asp-page="./Login"
               asp-route-returnUrl="@Model.ReturnUrl">
                Log in
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}