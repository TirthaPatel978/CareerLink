@model CareerLink.ViewModels.EducationViewModel

@{
    ViewData["Title"] = "Edit Education";
}

<div class="cl-education-page">

    <!-- PAGE HEADER -->
    <section class="cl-education-header">

        <div class="container">

            <div class="cl-education-header-content">

                <div>

                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-mortarboard"></i>
                        Professional Profile
                    </div>

                    <h1>Edit Education</h1>

                    <p>
                        Update your educational qualification
                        and academic information.
                    </p>

                </div>

                <a asp-action="Index"
                   class="cl-education-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Education
                </a>

            </div>

        </div>

    </section>


    <!-- FORM -->
    <section class="cl-education-form-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-8 col-xl-7">

                    <div class="cl-education-form-card">

                        <div class="cl-education-form-heading">

                            <div class="cl-education-form-icon">
                                <i class="bi bi-pencil"></i>
                            </div>

                            <div>

                                <div class="cl-small-label">
                                    UPDATE QUALIFICATION
                                </div>

                                <h2>Edit education record</h2>

                                <p>
                                    Keep your academic information
                                    accurate and up to date.
                                </p>

                            </div>

                        </div>


                        <form asp-action="Edit"
                              method="post">

                            <input type="hidden"
                                   asp-for="Id" />


                            <div asp-validation-summary="ModelOnly"
                                 class="cl-education-validation">
                            </div>


                            <!-- DEGREE -->
                            <div class="cl-education-field-group">

                                <label asp-for="Degree"
                                       class="cl-education-label">
                                </label>

                                <input asp-for="Degree"
                                       class="cl-education-input" />

                                <span asp-validation-for="Degree"
                                      class="cl-education-error">
                                </span>

                            </div>


                            <!-- FIELD OF STUDY -->
                            <div class="cl-education-field-group">

                                <label asp-for="FieldOfStudy"
                                       class="cl-education-label">
                                </label>

                                <input asp-for="FieldOfStudy"
                                       class="cl-education-input" />

                                <span asp-validation-for="FieldOfStudy"
                                      class="cl-education-error">
                                </span>

                            </div>


                            <!-- INSTITUTION -->
                            <div class="cl-education-field-group">

                                <label asp-for="Institution"
                                       class="cl-education-label">
                                </label>

                                <input asp-for="Institution"
                                       class="cl-education-input" />

                                <span asp-validation-for="Institution"
                                      class="cl-education-error">
                                </span>

                            </div>


                            <!-- DATES -->
                            <div class="row g-3">

                                <div class="col-md-6">

                                    <div class="cl-education-field-group">

                                        <label asp-for="StartDate"
                                               class="cl-education-label">
                                        </label>

                                        <input asp-for="StartDate"
                                               type="date"
                                               class="cl-education-input" />

                                        <span asp-validation-for="StartDate"
                                              class="cl-education-error">
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="cl-education-field-group">

                                        <label asp-for="EndDate"
                                               class="cl-education-label">
                                        </label>

                                        <input asp-for="EndDate"
                                               type="date"
                                               class="cl-education-input" />

                                        <div class="cl-education-help">
                                            <i class="bi bi-info-circle"></i>
                                            Leave empty if you are currently studying.
                                        </div>

                                        <span asp-validation-for="EndDate"
                                              class="cl-education-error">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- GRADE -->
                            <div class="cl-education-field-group">

                                <label asp-for="Grade"
                                       class="cl-education-label">
                                </label>

                                <input asp-for="Grade"
                                       class="cl-education-input" />

                                <span asp-validation-for="Grade"
                                      class="cl-education-error">
                                </span>

                            </div>


                            <!-- FOOTER -->
                            <div class="cl-education-form-footer">

                                <a asp-action="Index"
                                   class="cl-education-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-education-save-btn">
                                    <i class="bi bi-check2"></i>
                                    Save Changes
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}