@model CareerLink.ViewModels.EducationViewModel

@{
    ViewData["Title"] = "Delete Education";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">

                <div class="card-body p-4">

                    <h1 class="fw-bold text-danger">
                        Delete Education
                    </h1>

                    <p class="text-muted">
                        Are you sure you want to delete this education record?
                    </p>

                    <hr />

                    <dl class="row">

                        <dt class="col-sm-4">
                            Degree
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Degree
                        </dd>

                        <dt class="col-sm-4">
                            Field of Study
                        </dt>

                        <dd class="col-sm-8">
                            @Model.FieldOfStudy
                        </dd>

                        <dt class="col-sm-4">
                            Institution
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Institution
                        </dd>

                        <dt class="col-sm-4">
                            Start Date
                        </dt>

                        <dd class="col-sm-8">
                            @Model.StartDate.ToString("dd MMM yyyy")
                        </dd>

                        <dt class="col-sm-4">
                            End Date
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.EndDate.HasValue
                                ? Model.EndDate.Value.ToString("dd MMM yyyy")
                                : "Present")
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Grade))
                        {
                            <dt class="col-sm-4">
                                Grade
                            </dt>

                            <dd class="col-sm-8">
                                @Model.Grade
                            </dd>
                        }

                    </dl>

                    <form asp-action="DeleteConfirmed"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Education
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>