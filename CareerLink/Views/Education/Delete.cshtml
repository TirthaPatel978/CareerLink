@model CareerLink.ViewModels.EducationViewModel

@{
    ViewData["Title"] = "Delete Education";
}

<div class="cl-education-page">

    <!-- PAGE HEADER -->
    <section class="cl-education-header">

        <div class="container">

            <div class="cl-education-header-content">

                <div>

                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-mortarboard"></i>
                        Professional Profile
                    </div>

                    <h1>Delete Education</h1>

                    <p>
                        Review this qualification before
                        removing it from your profile.
                    </p>

                </div>

                <a asp-action="Index"
                   class="cl-education-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Education
                </a>

            </div>

        </div>

    </section>


    <!-- DELETE CONFIRMATION -->
    <section class="cl-education-form-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-7 col-xl-6">

                    <div class="cl-education-delete-card">

                        <div class="cl-education-delete-icon">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <div class="cl-small-label">
                            REMOVE QUALIFICATION
                        </div>

                        <h2>Are you sure?</h2>

                        <p class="cl-education-delete-description">
                            This will remove the education record
                            from your professional profile.
                        </p>


                        <!-- DETAILS -->
                        <div class="cl-education-delete-details">

                            <div class="cl-education-delete-detail">

                                <span>Degree</span>

                                <strong>
                                    @Model.Degree
                                </strong>

                            </div>


                            <div class="cl-education-delete-detail">

                                <span>Field of Study</span>

                                <strong>
                                    @Model.FieldOfStudy
                                </strong>

                            </div>


                            <div class="cl-education-delete-detail">

                                <span>Institution</span>

                                <strong>
                                    @Model.Institution
                                </strong>

                            </div>


                            <div class="cl-education-delete-detail">

                                <span>Duration</span>

                                <strong>
                                    @Model.StartDate.ToString("MMM yyyy")
                                    –
                                    @(Model.EndDate.HasValue
                                        ? Model.EndDate.Value.ToString("MMM yyyy")
                                        : "Present")
                                </strong>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(Model.Grade))
                            {
                                <div class="cl-education-delete-detail">

                                    <span>Grade</span>

                                    <strong>
                                        @Model.Grade
                                    </strong>

                                </div>
                            }

                        </div>


                        <form asp-action="DeleteConfirmed"
                              method="post">

                            <input type="hidden"
                                   asp-for="Id" />


                            <div class="cl-education-delete-footer">

                                <a asp-action="Index"
                                   class="cl-education-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-education-delete-confirm-btn">
                                    <i class="bi bi-trash3"></i>
                                    Delete Education
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>