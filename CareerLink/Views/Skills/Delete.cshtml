@model CareerLink.ViewModels.JobSeekerSkillViewModel

@{
    ViewData["Title"] = "Remove Skill";
}

<div class="cl-skills-page">

    <section class="cl-skills-header">
        <div class="container">

            <div class="cl-skills-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-tools"></i>
                        Professional Profile
                    </div>

                    <h1>Remove Skill</h1>

                    <p>
                        Review the skill before removing it from your profile.
                    </p>
                </div>

                <a asp-action="Index"
                   class="cl-skills-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Skills
                </a>

            </div>

        </div>
    </section>


    <section class="cl-skills-form-section">
        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-7 col-xl-6">

                    <div class="cl-skills-delete-card">

                        <div class="cl-skills-delete-icon">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <div class="cl-small-label">
                            REMOVE SKILL
                        </div>

                        <h2>Are you sure?</h2>

                        <p class="cl-skills-delete-description">
                            This will remove the skill from your professional
                            profile. You can add it again later if needed.
                        </p>


                        <div class="cl-skills-delete-details">

                            <div class="cl-skills-delete-detail">

                                <span>Skill</span>

                                <strong>
                                    @Model.SkillName
                                </strong>

                            </div>


                            <div class="cl-skills-delete-detail">

                                <span>Proficiency Level</span>

                                <strong>
                                    @switch (Model.ProficiencyLevel)
                                    {
                                        case 1:
                                            <text>Beginner</text>
                                            break;

                                        case 2:
                                            <text>Basic</text>
                                            break;

                                        case 3:
                                            <text>Intermediate</text>
                                            break;

                                        case 4:
                                            <text>Advanced</text>
                                            break;

                                        case 5:
                                            <text>Expert</text>
                                            break;
                                    }
                                </strong>

                            </div>

                        </div>


                        <form asp-action="DeleteConfirmed"
                              method="post">

                            <input type="hidden"
                               name="skillId"
                               value="@Model.SkillId" />


                            <div class="cl-skills-delete-footer">

                                <a asp-action="Index"
                                   class="cl-skills-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-skills-delete-confirm-btn">
                                    <i class="bi bi-trash3"></i>
                                    Remove Skill
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </section>

</div>