@model CareerLink.ViewModels.JobSeekerSkillViewModel

@{
    ViewData["Title"] = "Remove Skill";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card shadow-sm border-danger">

                <div class="card-body p-4">

                    <h1 class="fw-bold text-danger">
                        Remove Skill
                    </h1>

                    <p class="text-muted">
                        Are you sure you want to remove this skill?
                    </p>

                    <hr />

                    <p>
                        <strong>Skill:</strong>
                        @Model.SkillName
                    </p>

                    <p>
                        <strong>Proficiency Level:</strong>

                        @switch (Model.ProficiencyLevel)
                        {
                            case 1:
                                <span>Beginner</span>
                                break;

                            case 2:
                                <span>Basic</span>
                                break;

                            case 3:
                                <span>Intermediate</span>
                                break;

                            case 4:
                                <span>Advanced</span>
                                break;

                            case 5:
                                <span>Expert</span>
                                break;
                        }
                    </p>

                    <form asp-action="DeleteConfirmed"
                          method="post">

                        <input type="hidden"
                               asp-for="SkillId" />

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Remove Skill
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>