@model CareerLink.ViewModels.JobSeekerSkillViewModel

@{
    ViewData["Title"] = "Add Skill";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="mb-4">

                <h1 class="fw-bold">
                    Add Skill
                </h1>

                <p class="text-muted">
                    Add a skill to your professional profile.
                </p>

            </div>

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="Add"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-4">

                            <label asp-for="SkillName"
                                   class="form-label">
                            </label>

                            <input asp-for="SkillName"
                                   class="form-control"
                                   placeholder="e.g. C#, React, Python, Docker..." />

                            <div class="form-text">
                                Enter the name of your skill.
                            </div>

                            <span asp-validation-for="SkillName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ProficiencyLevel"
                                   class="form-label">
                            </label>

                            <select asp-for="ProficiencyLevel"
                                    class="form-select">

                                <option value="1">
                                    1 - Beginner
                                </option>

                                <option value="2">
                                    2 - Basic
                                </option>

                                <option value="3">
                                    3 - Intermediate
                                </option>

                                <option value="4">
                                    4 - Advanced
                                </option>

                                <option value="5">
                                    5 - Expert
                                </option>

                            </select>

                            <span asp-validation-for="ProficiencyLevel"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Add Skill
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}