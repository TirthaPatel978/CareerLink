@model CareerLink.ViewModels.JobSeekerSkillViewModel

@{
    ViewData["Title"] = "Add Skill";
}

<div class="cl-skills-page">

    <section class="cl-skills-header">
        <div class="container">

            <div class="cl-skills-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-tools"></i>
                        Professional Profile
                    </div>

                    <h1>Add Skill</h1>

                    <p>
                        Add a professional skill and tell employers
                        how confident you are with it.
                    </p>
                </div>

                <a asp-action="Index"
                   class="cl-skills-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Skills
                </a>

            </div>

        </div>
    </section>


    <section class="cl-skills-form-section">
        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-8 col-xl-7">

                    <div class="cl-skills-form-card">

                        <div class="cl-skills-form-heading">

                            <div class="cl-skills-form-icon">
                                <i class="bi bi-plus-lg"></i>
                            </div>

                            <div>
                                <div class="cl-small-label">
                                    NEW SKILL
                                </div>

                                <h2>Add a professional skill</h2>

                                <p>
                                    Add a skill that represents your
                                    professional knowledge or abilities.
                                </p>
                            </div>

                        </div>


                        <form asp-action="Add"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="cl-skills-validation">
                            </div>


                            <div class="cl-skills-field">

                                <label asp-for="SkillName"
                                       class="cl-skills-label">
                                </label>

                                <input asp-for="SkillName"
                                       class="cl-skills-input"
                                       placeholder="e.g. C#, React, Python, Docker..." />

                                <div class="cl-skills-help">
                                    <i class="bi bi-info-circle"></i>
                                    Enter the name of your skill.
                                </div>

                                <span asp-validation-for="SkillName"
                                      class="cl-skills-error">
                                </span>

                            </div>


                            <div class="cl-skills-field">

                                <label asp-for="ProficiencyLevel"
                                       class="cl-skills-label">
                                </label>

                                <select asp-for="ProficiencyLevel"
                                        class="cl-skills-select">

                                    <option value="1">
                                        1 - Beginner
                                    </option>

                                    <option value="2">
                                        2 - Basic
                                    </option>

                                    <option value="3">
                                        3 - Intermediate
                                    </option>

                                    <option value="4">
                                        4 - Advanced
                                    </option>

                                    <option value="5">
                                        5 - Expert
                                    </option>

                                </select>

                                <div class="cl-skills-help">
                                    <i class="bi bi-bar-chart"></i>
                                    Choose the level that best represents
                                    your current ability.
                                </div>

                                <span asp-validation-for="ProficiencyLevel"
                                      class="cl-skills-error">
                                </span>

                            </div>


                            <div class="cl-skills-form-footer">

                                <a asp-action="Index"
                                   class="cl-skills-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-skills-save-btn">
                                    <i class="bi bi-plus-lg"></i>
                                    Add Skill
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}