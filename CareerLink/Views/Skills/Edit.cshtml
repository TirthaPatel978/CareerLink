@model CareerLink.ViewModels.JobSeekerSkillViewModel

@{
    ViewData["Title"] = "Edit Skill";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="mb-4">

                <h1 class="fw-bold">
                    Edit Skill
                </h1>

                <p class="text-muted">
                    Update your proficiency level.
                </p>

            </div>

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="Edit"
                          method="post">

                        <input type="hidden"
                               asp-for="SkillId" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Skill
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.SkillName"
                                   readonly />

                            <div class="form-text">
                                Skill names cannot be changed here.
                                Remove the skill and add a new one if necessary.
                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ProficiencyLevel"
                                   class="form-label">
                            </label>

                            <select asp-for="ProficiencyLevel"
                                    class="form-select">

                                <option value="1">
                                    1 - Beginner
                                </option>

                                <option value="2">
                                    2 - Basic
                                </option>

                                <option value="3">
                                    3 - Intermediate
                                </option>

                                <option value="4">
                                    4 - Advanced
                                </option>

                                <option value="5">
                                    5 - Expert
                                </option>

                            </select>

                            <span asp-validation-for="ProficiencyLevel"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}