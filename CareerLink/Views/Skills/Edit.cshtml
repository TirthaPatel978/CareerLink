@model CareerLink.ViewModels.JobSeekerSkillViewModel

@{
    ViewData["Title"] = "Edit Skill";
}

<div class="cl-skills-page">

    <section class="cl-skills-header">
        <div class="container">

            <div class="cl-skills-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-tools"></i>
                        Professional Profile
                    </div>

                    <h1>Edit Skill</h1>

                    <p>
                        Update the proficiency level for this skill.
                    </p>
                </div>

                <a asp-action="Index"
                   class="cl-skills-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Skills
                </a>

            </div>

        </div>
    </section>


    <section class="cl-skills-form-section">
        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-8 col-xl-7">

                    <div class="cl-skills-form-card">

                        <div class="cl-skills-form-heading">

                            <div class="cl-skills-form-icon">
                                <i class="bi bi-pencil"></i>
                            </div>

                            <div>
                                <div class="cl-small-label">
                                    UPDATE SKILL
                                </div>

                                <h2>Edit your proficiency</h2>

                                <p>
                                    Keep your skill level accurate so your
                                    profile reflects your current abilities.
                                </p>
                            </div>

                        </div>


                        <form asp-action="Edit"
                              method="post">

                            <input type="hidden" asp-for="SkillId" />
                            <input type="hidden" asp-for="SkillName" />


                            <div asp-validation-summary="ModelOnly"
                                 class="cl-skills-validation">
                            </div>


                            <div class="cl-skills-field">

                                <label class="cl-skills-label">
                                    Skill
                                </label>

                                <div class="cl-skills-readonly">

                                    <div class="cl-skills-readonly-icon">
                                        <i class="bi bi-tools"></i>
                                    </div>

                                    <span>
                                        @Model.SkillName
                                    </span>

                                    <i class="bi bi-lock"></i>

                                </div>

                                <div class="cl-skills-help">
                                    <i class="bi bi-info-circle"></i>
                                    Skill names cannot be changed here.
                                    Remove the skill and add a new one if necessary.
                                </div>

                            </div>


                            <div class="cl-skills-field">

                                <label asp-for="ProficiencyLevel"
                                       class="cl-skills-label">
                                </label>

                                <select asp-for="ProficiencyLevel"
                                        class="cl-skills-select">

                                    <option value="1">
                                        1 - Beginner
                                    </option>

                                    <option value="2">
                                        2 - Basic
                                    </option>

                                    <option value="3">
                                        3 - Intermediate
                                    </option>

                                    <option value="4">
                                        4 - Advanced
                                    </option>

                                    <option value="5">
                                        5 - Expert
                                    </option>

                                </select>

                                <span asp-validation-for="ProficiencyLevel"
                                      class="cl-skills-error">
                                </span>

                            </div>


                            <div class="cl-skills-form-footer">

                                <a asp-action="Index"
                                   class="cl-skills-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-skills-save-btn">
                                    <i class="bi bi-check2"></i>
                                    Save Changes
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}