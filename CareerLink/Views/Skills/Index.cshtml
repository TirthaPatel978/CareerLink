@model IEnumerable<CareerLink.ViewModels.JobSeekerSkillViewModel>

@{
    ViewData["Title"] = "My Skills";
}

<div class="cl-skills-page">

    <!-- Page Header -->
    <section class="cl-skills-header">
        <div class="container">

            <div class="cl-skills-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-tools"></i>
                        Professional Profile
                    </div>

                    <h1>My Skills</h1>

                    <p>
                        Manage your professional skills and proficiency
                        levels to strengthen your CareerLink profile.
                    </p>
                </div>

                <a asp-action="Add"
                   class="cl-skills-add-btn">
                    <i class="bi bi-plus-lg"></i>
                    Add Skill
                </a>

            </div>

        </div>
    </section>


    <!-- Skills Content -->
    <section class="cl-skills-main">
        <div class="container">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="cl-skills-success">

                    <div class="cl-skills-success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <div>
                        <strong>Skill updated</strong>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>

                    <button type="button"
                            class="btn-close ms-auto"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            @if (!Model.Any())
            {
                <!-- Empty State -->
                <div class="cl-skills-empty">

                    <div class="cl-skills-empty-icon">
                        <i class="bi bi-tools"></i>
                    </div>

                    <div class="cl-skills-empty-label">
                        YOUR PROFESSIONAL SKILLS
                    </div>

                    <h2>No skills added yet</h2>

                    <p>
                        Add your skills and proficiency levels to give
                        employers a clearer picture of your professional
                        strengths.
                    </p>

                    <a asp-action="Add"
                       class="cl-skills-primary-btn">
                        <i class="bi bi-plus-lg"></i>
                        Add Your First Skill
                    </a>

                </div>
            }
            else
            {
                <div class="cl-skills-section-heading">

                    <div>
                        <div class="cl-small-label">
                            YOUR SKILLS
                        </div>

                        <h2>Professional strengths</h2>

                        <p>
                            Keep your skills and proficiency levels
                            up to date.
                        </p>
                    </div>

                    <div class="cl-skills-count">
                        <span>@Model.Count()</span>
                        <small>
                            @(Model.Count() == 1 ? "Skill" : "Skills")
                        </small>
                    </div>

                </div>


                <div class="row g-4">

                    @foreach (var skill in Model)
                    {
                        var proficiencyText = skill.ProficiencyLevel switch
                        {
                            1 => "Beginner",
                            2 => "Basic",
                            3 => "Intermediate",
                            4 => "Advanced",
                            5 => "Expert",
                            _ => "Not specified"
                        };

                        <div class="col-md-6 col-xl-4">

                            <div class="cl-skill-card">

                                <div class="cl-skill-card-top">

                                    <div class="cl-skill-icon">
                                        <i class="bi bi-tools"></i>
                                    </div>

                                    <div class="cl-skill-card-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@skill.SkillId"
                                           class="cl-skill-icon-btn"
                                           title="Edit skill">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@skill.SkillId"
                                           class="cl-skill-icon-btn cl-skill-delete-btn"
                                           title="Remove skill">
                                            <i class="bi bi-trash3"></i>
                                        </a>

                                    </div>

                                </div>


                                <div class="cl-skill-card-content">

                                    <h3>
                                        @skill.SkillName
                                    </h3>

                                    <div class="cl-skill-proficiency">

                                        <div class="cl-skill-proficiency-header">

                                            <span>
                                                Proficiency
                                            </span>

                                            <strong>
                                                @proficiencyText
                                            </strong>

                                        </div>


                                        <div class="cl-skill-levels">

                                            @for (var level = 1; level <= 5; level++)
                                            {
                                                <span class="@(level <= skill.ProficiencyLevel ? "active" : "")"></span>
                                            }

                                        </div>

                                    </div>

                                </div>


                                <div class="cl-skill-card-footer">

                                    <span>
                                        Level @skill.ProficiencyLevel of 5
                                    </span>

                                    <a asp-action="Edit"
                                       asp-route-id="@skill.SkillId">
                                        Edit
                                        <i class="bi bi-arrow-right"></i>
                                    </a>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>
    </section>

</div>