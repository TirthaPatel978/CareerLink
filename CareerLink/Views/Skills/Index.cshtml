@model IEnumerable<CareerLink.ViewModels.JobSeekerSkillViewModel>

@{
    ViewData["Title"] = "My Skills";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">My Skills</h1>
            <p class="text-muted mb-0">
                Manage your professional skills and proficiency levels.
            </p>
        </div>

        <a asp-action="Add"
           class="btn btn-primary">
            + Add Skill
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4>No skills added yet</h4>

                <p class="text-muted">
                    Add your skills to improve your professional profile.
                </p>

                <a asp-action="Add"
                   class="btn btn-primary">
                    Add Your First Skill
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var skill in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                @skill.SkillName
                            </h5>

                            <p class="mb-3">
                                <strong>Proficiency:</strong>

                                @switch (skill.ProficiencyLevel)
                                {
                                    case 1:
                                        <span>Beginner</span>
                                        break;

                                    case 2:
                                        <span>Basic</span>
                                        break;

                                    case 3:
                                        <span>Intermediate</span>
                                        break;

                                    case 4:
                                        <span>Advanced</span>
                                        break;

                                    case 5:
                                        <span>Expert</span>
                                        break;
                                }
                            </p>

                            <div class="d-flex gap-2">

                                <a asp-action="Edit"
                                   asp-route-id="@skill.SkillId"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@skill.SkillId"
                                   class="btn btn-outline-danger btn-sm">
                                    Remove
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>