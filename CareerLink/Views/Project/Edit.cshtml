@model CareerLink.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = "Edit Project";
}

<div class="cl-projects-page">

    <!-- Header -->
    <section class="cl-projects-header">

        <div class="container">

            <div class="cl-projects-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-kanban"></i>
                        Professional Profile
                    </div>

                    <h1>Edit Project</h1>

                    <p>
                        Keep your project information accurate and
                        up to date.
                    </p>
                </div>

                <a asp-action="Index"
                   class="cl-projects-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Projects
                </a>

            </div>

        </div>

    </section>


    <!-- Form -->
    <section class="cl-projects-form-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-9 col-xl-8">

                    <div class="cl-projects-form-card">

                        <div class="cl-projects-form-heading">

                            <div class="cl-projects-form-icon">
                                <i class="bi bi-pencil"></i>
                            </div>

                            <div>
                                <div class="cl-small-label">
                                    UPDATE PROJECT
                                </div>

                                <h2>Edit project details</h2>

                                <p>
                                    Update the information shown on
                                    your professional profile.
                                </p>
                            </div>

                        </div>


                        <form asp-action="Edit"
                              method="post">

                            <input type="hidden"
                                   asp-for="Id" />

                            <div asp-validation-summary="ModelOnly"
                                 class="cl-projects-validation">
                            </div>


                            <!-- Project Name -->
                            <div class="cl-projects-field">

                                <label asp-for="Name"
                                       class="cl-projects-label">
                                </label>

                                <input asp-for="Name"
                                       class="cl-projects-input" />

                                <span asp-validation-for="Name"
                                      class="cl-projects-error">
                                </span>

                            </div>


                            <!-- Technologies -->
                            <div class="cl-projects-field">

                                <label asp-for="Technologies"
                                       class="cl-projects-label">
                                </label>

                                <input asp-for="Technologies"
                                       class="cl-projects-input" />

                                <div class="cl-projects-help">
                                    <i class="bi bi-info-circle"></i>
                                    Separate multiple technologies with commas.
                                </div>

                                <span asp-validation-for="Technologies"
                                      class="cl-projects-error">
                                </span>

                            </div>


                            <!-- Description -->
                            <div class="cl-projects-field">

                                <label asp-for="Description"
                                       class="cl-projects-label">
                                </label>

                                <textarea asp-for="Description"
                                          class="cl-projects-input cl-projects-textarea"
                                          rows="5"></textarea>

                                <span asp-validation-for="Description"
                                      class="cl-projects-error">
                                </span>

                            </div>


                            <!-- Dates -->
                            <div class="row">

                                <div class="col-md-6">

                                    <div class="cl-projects-field">

                                        <label asp-for="StartDate"
                                               class="cl-projects-label">
                                        </label>

                                        <input asp-for="StartDate"
                                               type="date"
                                               class="cl-projects-input" />

                                        <span asp-validation-for="StartDate"
                                              class="cl-projects-error">
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="cl-projects-field">

                                        <label asp-for="EndDate"
                                               class="cl-projects-label">
                                        </label>

                                        <input asp-for="EndDate"
                                               type="date"
                                               class="cl-projects-input" />

                                        <span asp-validation-for="EndDate"
                                              class="cl-projects-error">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- Project URL -->
                            <div class="cl-projects-field">

                                <label asp-for="ProjectUrl"
                                       class="cl-projects-label">
                                </label>

                                <div class="cl-projects-input-with-icon">

                                    <i class="bi bi-link-45deg"></i>

                                    <input asp-for="ProjectUrl"
                                           class="cl-projects-input" />

                                </div>

                                <span asp-validation-for="ProjectUrl"
                                      class="cl-projects-error">
                                </span>

                            </div>


                            <!-- GitHub -->
                            <div class="cl-projects-field">

                                <label asp-for="GithubUrl"
                                       class="cl-projects-label">
                                </label>

                                <div class="cl-projects-input-with-icon">

                                    <i class="bi bi-github"></i>

                                    <input asp-for="GithubUrl"
                                           class="cl-projects-input" />

                                </div>

                                <span asp-validation-for="GithubUrl"
                                      class="cl-projects-error">
                                </span>

                            </div>


                            <!-- Footer -->
                            <div class="cl-projects-form-footer">

                                <a asp-action="Index"
                                   class="cl-projects-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-projects-save-btn">
                                    <i class="bi bi-check2"></i>
                                    Save Changes
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}