@model CareerLink.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = "Add Project";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="mb-4">

                <h1 class="fw-bold">Add Project</h1>

                <p class="text-muted">
                    Add a project to your professional profile.
                </p>

            </div>

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="e.g. CareerLink Job Portal" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Technologies"
                                   class="form-label">
                            </label>

                            <input asp-for="Technologies"
                                   class="form-control"
                                   placeholder="e.g. C#, ASP.NET Core, SQL Server, Bootstrap" />

                            <div class="form-text">
                                Separate technologies with commas.
                            </div>

                            <span asp-validation-for="Technologies"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe the project and your contribution...">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="StartDate"
                                       class="form-label">
                                </label>

                                <input asp-for="StartDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="StartDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="EndDate"
                                       class="form-label">
                                </label>

                                <input asp-for="EndDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="EndDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="ProjectUrl"
                                   class="form-label">
                            </label>

                            <input asp-for="ProjectUrl"
                                   class="form-control"
                                   placeholder="https://example.com/project" />

                            <span asp-validation-for="ProjectUrl"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="GithubUrl"
                                   class="form-label">
                            </label>

                            <input asp-for="GithubUrl"
                                   class="form-control"
                                   placeholder="https://github.com/username/project" />

                            <span asp-validation-for="GithubUrl"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Add Project
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}