@model CareerLink.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = "Delete Project";
}

<div class="cl-projects-page">

    <!-- Header -->
    <section class="cl-projects-header">

        <div class="container">

            <div class="cl-projects-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-kanban"></i>
                        Professional Profile
                    </div>

                    <h1>Delete Project</h1>

                    <p>
                        Review the project before removing it from
                        your professional profile.
                    </p>
                </div>

                <a asp-action="Index"
                   class="cl-projects-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Projects
                </a>

            </div>

        </div>

    </section>


    <!-- Delete -->
    <section class="cl-projects-form-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-7 col-xl-6">

                    <div class="cl-projects-delete-card">

                        <div class="cl-projects-delete-icon">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <div class="cl-small-label">
                            REMOVE PROJECT
                        </div>

                        <h2>Are you sure?</h2>

                        <p class="cl-projects-delete-description">
                            This will remove the project from your
                            professional profile. You can add it again
                            later if needed.
                        </p>


                        <!-- Project Details -->
                        <div class="cl-projects-delete-details">

                            <div class="cl-projects-delete-detail">

                                <span>Project</span>

                                <strong>
                                    @Model.Name
                                </strong>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(Model.Technologies))
                            {
                                <div class="cl-projects-delete-detail">

                                    <span>Technologies</span>

                                    <strong>
                                        @Model.Technologies
                                    </strong>

                                </div>
                            }


                            @if (Model.StartDate.HasValue ||
                                 Model.EndDate.HasValue)
                            {
                                <div class="cl-projects-delete-detail">

                                    <span>Duration</span>

                                    <strong>

                                        @if (Model.StartDate.HasValue)
                                        {
                                            @Model.StartDate.Value.ToString("MMM yyyy")
                                        }

                                        @if (Model.StartDate.HasValue &&
                                             Model.EndDate.HasValue)
                                        {
                                            @: -
                                        }

                                        @if (Model.EndDate.HasValue)
                                        {
                                            @Model.EndDate.Value.ToString("MMM yyyy")
                                        }

                                    </strong>

                                </div>
                            }

                        </div>


                        <form asp-action="DeleteConfirmed"
                              method="post">

                            <input type="hidden"
                                   asp-for="Id" />

                            <div class="cl-projects-delete-footer">

                                <a asp-action="Index"
                                   class="cl-projects-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-projects-delete-confirm-btn">
                                    <i class="bi bi-trash3"></i>
                                    Delete Project
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>