@model IEnumerable<CareerLink.ViewModels.ProjectViewModel>

@{
    ViewData["Title"] = "My Projects";
}

<div class="cl-projects-page">

    <!-- Header -->
    <section class="cl-projects-header">
        <div class="container">
            <div class="cl-projects-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-kanban"></i>
                        Professional Profile
                    </div>

                    <h1>My Projects</h1>

                    <p>
                        Showcase projects that demonstrate your skills,
                        experience and practical work.
                    </p>
                </div>

                <a asp-action="Create"
                   class="cl-projects-add-btn">
                    <i class="bi bi-plus-lg"></i>
                    Add Project
                </a>

            </div>
        </div>
    </section>


    <!-- Main -->
    <section class="cl-projects-main">
        <div class="container">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="cl-projects-success">

                    <div class="cl-projects-success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <div>
                        <strong>Project updated</strong>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>

                    <button type="button"
                            class="btn-close ms-auto"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            @if (!Model.Any())
            {
                <!-- Empty State -->
                <div class="cl-projects-empty">

                    <div class="cl-projects-empty-icon">
                        <i class="bi bi-kanban"></i>
                    </div>

                    <div class="cl-small-label">
                        YOUR PROJECT PORTFOLIO
                    </div>

                    <h2>No projects added yet</h2>

                    <p>
                        Add projects you've worked on to help employers
                        understand your practical skills and experience.
                    </p>

                    <a asp-action="Create"
                       class="cl-projects-primary-btn">
                        <i class="bi bi-plus-lg"></i>
                        Add Your First Project
                    </a>

                </div>
            }
            else
            {
                <!-- Section Heading -->
                <div class="cl-projects-section-heading">

                    <div>
                        <div class="cl-small-label">
                            YOUR PROJECTS
                        </div>

                        <h2>Featured work</h2>

                        <p>
                            Keep your project portfolio current and
                            relevant to your career goals.
                        </p>
                    </div>

                    <div class="cl-projects-count">
                        <strong>@Model.Count()</strong>
                        <span>
                            @(Model.Count() == 1 ? "Project" : "Projects")
                        </span>
                    </div>

                </div>


                <!-- Project Cards -->
                <div class="row g-4">

                    @foreach (var project in Model)
                    {
                        <div class="col-md-6 col-xl-4">

                            <article class="cl-project-card">

                                <div class="cl-project-card-top">

                                    <div class="cl-project-icon">
                                        <i class="bi bi-kanban"></i>
                                    </div>

                                    <div class="cl-project-card-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@project.Id"
                                           class="cl-project-icon-btn"
                                           title="Edit project">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@project.Id"
                                           class="cl-project-icon-btn cl-project-delete-btn"
                                           title="Delete project">
                                            <i class="bi bi-trash3"></i>
                                        </a>

                                    </div>

                                </div>


                                <div class="cl-project-card-content">

                                    <h3>
                                        @project.Name
                                    </h3>


                                    @if (!string.IsNullOrWhiteSpace(project.Technologies))
                                    {
                                        <div class="cl-project-technologies">

                                            <div class="cl-project-meta-label">
                                                <i class="bi bi-code-slash"></i>
                                                Technologies
                                            </div>

                                            <p>
                                                @project.Technologies
                                            </p>

                                        </div>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(project.Description))
                                    {
                                        <p class="cl-project-description">
                                            @project.Description
                                        </p>
                                    }


                                    @if (project.StartDate.HasValue ||
                                         project.EndDate.HasValue)
                                    {
                                        <div class="cl-project-duration">

                                            <i class="bi bi-calendar3"></i>

                                            <span>
                                                @if (project.StartDate.HasValue)
                                                {
                                                    @project.StartDate.Value.ToString("MMM yyyy")
                                                }

                                                @if (project.StartDate.HasValue &&
                                                     project.EndDate.HasValue)
                                                {
                                                    @: -
                                                }

                                                @if (project.EndDate.HasValue)
                                                {
                                                    @project.EndDate.Value.ToString("MMM yyyy")
                                                }
                                            </span>

                                        </div>
                                    }

                                </div>


                                <div class="cl-project-card-footer">

                                    <div class="cl-project-links">

                                        @if (!string.IsNullOrWhiteSpace(project.ProjectUrl))
                                        {
                                            <a href="@project.ProjectUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="cl-project-link">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                                Project
                                            </a>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(project.GithubUrl))
                                        {
                                            <a href="@project.GithubUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="cl-project-link cl-project-github-link">
                                                <i class="bi bi-github"></i>
                                                GitHub
                                            </a>
                                        }

                                    </div>


                                    <a asp-action="Edit"
                                       asp-route-id="@project.Id"
                                       class="cl-project-edit-link">
                                        Edit
                                        <i class="bi bi-arrow-right"></i>
                                    </a>

                                </div>

                            </article>

                        </div>
                    }

                </div>
            }

        </div>
    </section>

</div>