@model IEnumerable<CareerLink.ViewModels.ProjectViewModel>

@{
    ViewData["Title"] = "My Projects";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold">My Projects</h1>

            <p class="text-muted mb-0">
                Showcase projects you have worked on.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Project
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4>No projects added yet</h4>

                <p class="text-muted">
                    Showcase your projects to strengthen your profile.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Add Your First Project
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var project in Model)
            {
                <div class="col-md-6">

                    <div class="card shadow-sm h-100">

                        <div class="card-body d-flex flex-column">

                            <h4 class="card-title">
                                @project.Name
                            </h4>

                            @if (!string.IsNullOrWhiteSpace(project.Technologies))
                            {
                                <p class="mb-2">

                                    <strong>Technologies:</strong>

                                    @project.Technologies

                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(project.Description))
                            {
                                <p class="text-muted">
                                    @project.Description
                                </p>
                            }

                            @if (project.StartDate.HasValue ||
                                 project.EndDate.HasValue)
                            {
                                <p class="small text-muted">

                                    @if (project.StartDate.HasValue)
                                    {
                                        @project.StartDate.Value.ToString("MMM yyyy")
                                    }

                                    @if (project.StartDate.HasValue &&
                                         project.EndDate.HasValue)
                                    {
                                        @: -
                                    }

                                    @if (project.EndDate.HasValue)
                                    {
                                        @project.EndDate.Value.ToString("MMM yyyy")
                                    }

                                </p>
                            }

                            <div class="mt-auto">

                                <div class="d-flex flex-wrap gap-2 mb-3">

                                    @if (!string.IsNullOrWhiteSpace(project.ProjectUrl))
                                    {
                                        <a href="@project.ProjectUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="btn btn-outline-primary btn-sm">
                                            Project
                                        </a>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(project.GithubUrl))
                                    {
                                        <a href="@project.GithubUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="btn btn-outline-dark btn-sm">
                                            GitHub
                                        </a>
                                    }

                                </div>

                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@project.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@project.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        Delete
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>