@model CareerLink.ViewModels.AdminCompanyDetailsViewModel

@{
    ViewData["Title"] = "Company Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">@Model.Name</h1>
            <p class="text-muted mb-0">
                Company details and platform activity.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="AdminCompanies"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Companies
            </a>

            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Dashboard
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h5 class="card-title">Company Information</h5>

                    <dl class="row mb-0">

                        <dt class="col-sm-4">Company Name</dt>
                        <dd class="col-sm-8">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-4">Industry</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Industry)
                                ? "Not provided"
                                : Model.Industry)
                        </dd>

                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Location)
                                ? "Not provided"
                                : Model.Location)
                        </dd>

                        <dt class="col-sm-4">Website</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(Model.Website))
                            {
                                <a href="@Model.Website"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    @Model.Website
                                </a>
                            }
                            else
                            {
                                <span>Not provided</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">
                            @(Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))
                        </dd>

                    </dl>

                </div>
            </div>

            <div class="card shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">Description</h5>

                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-0">
                            No company description has been provided.
                        </p>
                    }
                    else
                    {
                        <p class="mb-0">
                            @Model.Description
                        </p>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h5 class="card-title mb-3">
                        Platform Activity
                    </h5>

                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span>Recruiters</span>
                        <strong>@Model.RecruiterCount</strong>
                    </div>

                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span>Total Jobs</span>
                        <strong>@Model.JobCount</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2">
                        <span>Active Jobs</span>
                        <strong>@Model.ActiveJobCount</strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>