@model CareerLink.ViewModels.AdminCompanyDetailsViewModel

@{
    ViewData["Title"] = "Company Details";
}

<div class="cl-admin-page">

    <div class="cl-admin-page-header">

        <div>
            <div class="cl-admin-eyebrow">
                <i class="bi bi-building"></i>
                COMPANY DETAILS
            </div>

            <h1 class="cl-admin-title">
                @Model.Name
            </h1>

            <p class="cl-admin-subtitle">
                Company details and platform activity.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="AdminCompanies"
               asp-action="Index"
               class="cl-soft-button">
                <i class="bi bi-arrow-left"></i>
                Companies
            </a>

            <a asp-controller="Admin"
               asp-action="Index"
               class="cl-soft-button">
                Dashboard
            </a>

        </div>

    </div>

    <div class="cl-admin-details-grid">

        <div>

            <div class="cl-admin-detail-card">

                <div class="cl-admin-detail-card-header">

                    <div class="cl-admin-detail-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <div>
                        <h2>Company Information</h2>
                        <p>Registered company details.</p>
                    </div>

                </div>

                <div class="cl-admin-detail-list">

                    <div>
                        <span>Company Name</span>
                        <strong>@Model.Name</strong>
                    </div>

                    <div>
                        <span>Industry</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Industry)
                                ? "Not provided"
                                : Model.Industry)
                        </strong>
                    </div>

                    <div>
                        <span>Location</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Location)
                                ? "Not provided"
                                : Model.Location)
                        </strong>
                    </div>

                    <div>
                        <span>Website</span>
                        <strong>
                            @if (!string.IsNullOrWhiteSpace(Model.Website))
                            {
                                <a href="@Model.Website"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    @Model.Website
                                </a>
                            }
                            else
                            {
                                <span>Not provided</span>
                            }
                        </strong>
                    </div>

                    <div>
                        <span>Created</span>
                        <strong>
                            @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </strong>
                    </div>

                </div>

            </div>

            <div class="cl-admin-detail-card mt-4">

                <div class="cl-admin-detail-card-header">

                    <div class="cl-admin-detail-icon">
                        <i class="bi bi-file-text"></i>
                    </div>

                    <div>
                        <h2>Description</h2>
                        <p>Company overview.</p>
                    </div>

                </div>

                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="cl-admin-empty-content">
                        No company description has been provided.
                    </p>
                }
                else
                {
                    <p class="cl-admin-description">
                        @Model.Description
                    </p>
                }

            </div>

        </div>

        <div>

            <div class="cl-admin-detail-card">

                <div class="cl-admin-detail-card-header">

                    <div class="cl-admin-detail-icon">
                        <i class="bi bi-bar-chart"></i>
                    </div>

                    <div>
                        <h2>Platform Activity</h2>
                        <p>Company activity summary.</p>
                    </div>

                </div>

                <div class="cl-admin-activity-stat">
                    <span>Recruiters</span>
                    <strong>@Model.RecruiterCount</strong>
                </div>

                <div class="cl-admin-activity-stat">
                    <span>Total Jobs</span>
                    <strong>@Model.JobCount</strong>
                </div>

                <div class="cl-admin-activity-stat">
                    <span>Active Jobs</span>
                    <strong>@Model.ActiveJobCount</strong>
                </div>

            </div>

        </div>

    </div>

</div>