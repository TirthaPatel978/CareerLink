@model IEnumerable<CareerLink.ViewModels.AdminCompanyListViewModel>

@{
    ViewData["Title"] = "Manage Companies";
}

<div class="cl-admin-page">

    <div class="cl-admin-page-header">

        <div>
            <div class="cl-admin-eyebrow">
                <i class="bi bi-building"></i>
                COMPANY MANAGEMENT
            </div>

            <h1 class="cl-admin-title">
                Manage Companies
            </h1>

            <p class="cl-admin-subtitle">
                View companies registered on the CareerLink platform.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="cl-soft-button">
            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>

    </div>

    <div class="cl-admin-table-card">

        <div class="cl-admin-table-header">
            <div>
                <h2>Registered Companies</h2>
                <p>@Model.Count() compan@(Model.Count() == 1 ? "y" : "ies") available.</p>
            </div>

            <div class="cl-admin-table-count">
                <i class="bi bi-building"></i>
                @Model.Count()
            </div>
        </div>

        <div class="table-responsive">

            <table class="table cl-admin-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Industry</th>
                        <th>Location</th>
                        <th>Recruiters</th>
                        <th>Jobs</th>
                        <th>Created</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var company in Model)
                    {
                        <tr>

                            <td>
                                <div class="cl-admin-company-cell">
                                    <div class="cl-admin-company-icon">
                                        <i class="bi bi-building"></i>
                                    </div>

                                    <strong>@company.Name</strong>
                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(company.Industry)
                                    ? "—"
                                    : company.Industry)
                            </td>

                            <td>
                                <span class="cl-admin-location">
                                    <i class="bi bi-geo-alt"></i>
                                    @(string.IsNullOrWhiteSpace(company.Location)
                                        ? "—"
                                        : company.Location)
                                </span>
                            </td>

                            <td>
                                <span class="cl-admin-number-badge">
                                    @company.RecruiterCount
                                </span>
                            </td>

                            <td>
                                <span class="cl-admin-number-badge">
                                    @company.JobCount
                                </span>
                            </td>

                            <td>
                                @company.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </td>

                            <td class="text-end">

                                <a asp-controller="AdminCompanies"
                                   asp-action="Details"
                                   asp-route-id="@company.Id"
                                   class="cl-view-applicant-button">
                                    View Details
                                    <i class="bi bi-arrow-right"></i>
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @if (!Model.Any())
        {
            <div class="cl-admin-empty-state">
                <div>
                    <i class="bi bi-building"></i>
                </div>
                <h3>No companies found</h3>
                <p>There are currently no companies registered.</p>
            </div>
        }

    </div>

</div>