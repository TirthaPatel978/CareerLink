@model IEnumerable<CareerLink.ViewModels.AdminCompanyListViewModel>

@{
    ViewData["Title"] = "Manage Companies";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Manage Companies</h1>
            <p class="text-muted mb-0">
                View companies registered on the CareerLink platform.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Industry</th>
                            <th>Location</th>
                            <th>Recruiters</th>
                            <th>Jobs</th>
                            <th>Created</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var company in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@company.Name</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(company.Industry)
                                        ? "—"
                                        : company.Industry)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(company.Location)
                                        ? "—"
                                        : company.Location)
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @company.RecruiterCount
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @company.JobCount
                                    </span>
                                </td>

                                <td>
                                    @(company.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))
                                </td>

                                <td class="text-end">
                                    <a asp-controller="AdminCompanies"
                                       asp-action="Details"
                                       asp-route-id="@company.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>No companies found.</h5>
                    <p class="text-muted mb-0">
                        There are currently no companies registered.
                    </p>
                </div>
            }

        </div>

    </div>

</div>