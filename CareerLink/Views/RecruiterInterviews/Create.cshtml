@model CareerLink.ViewModels.RecruiterInterviewViewModel

@{
    ViewData["Title"] = "Schedule Interview";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Schedule Interview</h1>
            <p class="text-muted mb-0">
                @Model.JobTitle - @Model.ApplicantName
            </p>
        </div>

        <a asp-controller="RecruiterApplications"
           asp-action="Details"
           asp-route-id="@Model.ApplicationId"
           class="btn btn-outline-secondary">
            Back to Applicant
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (ViewBag.ValidationErrors != null)
            {
                <div class="alert alert-danger">
                    <h5 class="alert-heading">
                        The interview could not be scheduled.
                    </h5>

                    <ul class="mb-0">
                        @foreach (var error in (IEnumerable<string>)ViewBag.ValidationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <form asp-controller="RecruiterInterviews"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="ApplicationId"
                       value="@Model.ApplicationId" />

                <div asp-validation-summary="All"
                     class="alert alert-danger">
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Applicant
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.ApplicantName (@Model.ApplicantEmail)"
                           readonly />
                </div>

                <div class="mb-3">
                    <label for="ScheduledAt"
                           class="form-label">
                        Interview Date and Time
                    </label>

                    <input type="datetime-local"
                           id="ScheduledAt"
                           name="ScheduledAt"
                           class="form-control"
                           value="@Model.ScheduledAt.ToString("yyyy-MM-ddTHH:mm")"
                           required />

                    <span asp-validation-for="ScheduledAt"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label for="InterviewType"
                           class="form-label">
                        Interview Type
                    </label>

                    <select id="InterviewType"
                            name="InterviewType"
                            class="form-select">

                        <option value="0"
                                selected="@(Model.InterviewType == CareerLink.Models.Enums.InterviewType.Online)">
                            Online
                        </option>

                        <option value="1"
                                selected="@(Model.InterviewType == CareerLink.Models.Enums.InterviewType.InPerson)">
                            In Person
                        </option>

                        <option value="2"
                                selected="@(Model.InterviewType == CareerLink.Models.Enums.InterviewType.Phone)">
                            Phone
                        </option>

                    </select>

                    <span asp-validation-for="InterviewType"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3"
                     id="meetingLinkGroup">

                    <label for="MeetingLink"
                           class="form-label">
                        Meeting Link
                    </label>

                    <input type="text"
                           id="MeetingLink"
                           name="MeetingLink"
                           class="form-control"
                           value="@Model.MeetingLink"
                           placeholder="https://meet.google.com/..." />

                    <span asp-validation-for="MeetingLink"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Required for an online interview.
                    </div>
                </div>

                <div class="mb-3"
                     id="locationGroup">

                    <label for="Location"
                           class="form-label">
                        Location
                    </label>

                    <input type="text"
                           id="Location"
                           name="Location"
                           class="form-control"
                           value="@Model.Location"
                           placeholder="Office address or interview location" />

                    <span asp-validation-for="Location"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Required for an in-person interview.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="Notes"
                           class="form-label">
                        Notes
                    </label>

                    <textarea id="Notes"
                              name="Notes"
                              class="form-control"
                              rows="4"
                              placeholder="Interview instructions or additional notes">@Model.Notes</textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Schedule Interview
                    </button>

                    <a asp-controller="RecruiterApplications"
                       asp-action="Details"
                       asp-route-id="@Model.ApplicationId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateInterviewFields() {

            const type =
                document.getElementById("InterviewType").value;

            const meetingLinkGroup =
                document.getElementById("meetingLinkGroup");

            const locationGroup =
                document.getElementById("locationGroup");

            if (type === "0") {
                meetingLinkGroup.style.display = "block";
                locationGroup.style.display = "none";
            }
            else if (type === "1") {
                meetingLinkGroup.style.display = "none";
                locationGroup.style.display = "block";
            }
            else {
                meetingLinkGroup.style.display = "none";
                locationGroup.style.display = "none";
            }
        }

        document
            .getElementById("InterviewType")
            .addEventListener("change", updateInterviewFields);

        updateInterviewFields();
    </script>
}