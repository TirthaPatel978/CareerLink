@model CareerLink.ViewModels.RecruiterInterviewViewModel

@{
    ViewData["Title"] = "Reschedule Interview";
}

<div class="cl-recruiter-page">

    <div class="cl-profile-page-header">

        <div>
            <div class="cl-recruiter-eyebrow">
                <i class="bi bi-calendar-event"></i>
                INTERVIEW MANAGEMENT
            </div>

            <h1 class="cl-profile-page-title">
                Reschedule Interview
            </h1>

            <p class="cl-profile-page-subtitle">
                @Model.JobTitle - @Model.ApplicantName
            </p>
        </div>

        <a asp-controller="RecruiterInterviews"
           asp-action="Index"
           class="cl-soft-button">
            <i class="bi bi-arrow-left"></i>
            Back to Interviews
        </a>

    </div>

    <div class="cl-interview-form-grid">

        <div class="cl-profile-card">

            <div class="cl-profile-card-header">

                <div class="cl-profile-card-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>

                <div>
                    <h2>Update Interview</h2>
                    <p>
                        Change the interview schedule or format.
                    </p>
                </div>

            </div>

            <div class="cl-profile-card-body">

                @if (ViewBag.ValidationErrors != null)
                {
                    <div class="cl-interview-validation">
                        <i class="bi bi-exclamation-triangle-fill"></i>

                        <div>
                            <strong>
                                The interview could not be rescheduled.
                            </strong>

                            <ul>
                                @foreach (var error in (IEnumerable<string>)ViewBag.ValidationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <form asp-controller="RecruiterInterviews"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="Id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="ApplicationId"
                           value="@Model.ApplicationId" />

                    <div asp-validation-summary="All"
                         class="cl-profile-validation">
                    </div>

                    <div class="cl-interview-applicant-box">

                        <div class="cl-applicant-avatar">
                            @(
                                string.IsNullOrWhiteSpace(Model.ApplicantName)
                                    ? "?"
                                    : Model.ApplicantName.Substring(0, 1).ToUpper()
                             )
                        </div>

                        <div>
                            <span>Interview with</span>
                            <strong>@Model.ApplicantName</strong>
                            <small>@Model.ApplicantEmail</small>
                        </div>

                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label for="ScheduledAt"
                                   class="form-label">
                                Interview Date and Time
                            </label>

                            <input type="datetime-local"
                                   id="ScheduledAt"
                                   name="ScheduledAt"
                                   class="form-control"
                                   value="@Model.ScheduledAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")"
                                   required />

                            <span asp-validation-for="ScheduledAt"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label for="InterviewType"
                                   class="form-label">
                                Interview Type
                            </label>

                            <select id="InterviewType"
                                    name="InterviewType"
                                    class="form-select">

                                <option value="0"
                                        selected="@(Model.InterviewType == CareerLink.Models.Enums.InterviewType.Online)">
                                    Online
                                </option>

                                <option value="1"
                                        selected="@(Model.InterviewType == CareerLink.Models.Enums.InterviewType.InPerson)">
                                    In Person
                                </option>

                                <option value="2"
                                        selected="@(Model.InterviewType == CareerLink.Models.Enums.InterviewType.Phone)">
                                    Phone
                                </option>

                            </select>

                        </div>

                        <div class="col-12"
                             id="meetingLinkGroup">

                            <label for="MeetingLink"
                                   class="form-label">
                                Meeting Link
                            </label>

                            <div class="cl-interview-input-icon">
                                <i class="bi bi-link-45deg"></i>

                                <input type="text"
                                       id="MeetingLink"
                                       name="MeetingLink"
                                       class="form-control"
                                       value="@Model.MeetingLink"
                                       placeholder="https://meet.google.com/..." />
                            </div>

                            <span asp-validation-for="MeetingLink"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-12"
                             id="locationGroup">

                            <label for="Location"
                                   class="form-label">
                                Location
                            </label>

                            <div class="cl-interview-input-icon">
                                <i class="bi bi-geo-alt"></i>

                                <input type="text"
                                       id="Location"
                                       name="Location"
                                       class="form-control"
                                       value="@Model.Location"
                                       placeholder="Office address or interview location" />
                            </div>

                            <span asp-validation-for="Location"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-12">

                            <label for="Notes"
                                   class="form-label">
                                Notes
                            </label>

                            <textarea id="Notes"
                                      name="Notes"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Interview instructions or additional notes">@Model.Notes</textarea>

                        </div>

                    </div>

                    <div class="cl-profile-form-footer">

                        <a asp-controller="RecruiterInterviews"
                           asp-action="Index"
                           class="cl-soft-button">
                            Cancel
                        </a>

                        <button type="submit"
                                class="cl-purple-button">
                            <i class="bi bi-calendar-check"></i>
                            Save Reschedule
                        </button>

                    </div>

                </form>

            </div>

        </div>

        <div class="cl-interview-info-column">

            <div class="cl-profile-card cl-interview-info-card">

                <div class="cl-profile-side-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <h3>Rescheduling</h3>

                <p>
                    Changing an existing scheduled interview will update
                    its status to <strong>Rescheduled</strong>.
                </p>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateInterviewFields() {

            const type = document.getElementById("InterviewType").value;

            const meetingLinkGroup =
                document.getElementById("meetingLinkGroup");

            const locationGroup =
                document.getElementById("locationGroup");

            if (type === "0") {
                meetingLinkGroup.style.display = "block";
                locationGroup.style.display = "none";
            }
            else if (type === "1") {
                meetingLinkGroup.style.display = "none";
                locationGroup.style.display = "block";
            }
            else {
                meetingLinkGroup.style.display = "none";
                locationGroup.style.display = "none";
            }
        }

        document
            .getElementById("InterviewType")
            .addEventListener("change", updateInterviewFields);

        updateInterviewFields();
    </script>
}