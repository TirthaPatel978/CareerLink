@using CareerLink.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager


@if (SignInManager.IsSignedIn(User))
{

    <li class="nav-item dropdown">

        <button class="cl-account-button dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">

            <span class="cl-account-icon">

                <i class="bi bi-person"></i>

            </span>


            <span class="cl-account-email">

                @(User.Identity?.Name ?? "Account")

            </span>

        </button>


        <ul class="dropdown-menu dropdown-menu-end cl-account-menu">


            <li class="cl-account-menu-header">

                <span>
                    Signed in as
                </span>

                <strong>
                    @(User.Identity?.Name ?? "Account")
                </strong>

            </li>


            <li>
                <hr class="dropdown-divider" />
            </li>


            <li>

                <a class="dropdown-item"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index">

                    <i class="bi bi-person-circle me-2"></i>

                    Account

                </a>

            </li>


            <li>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      method="post">

                    <button type="submit"
                            class="dropdown-item cl-logout-item">

                        <i class="bi bi-box-arrow-right me-2"></i>

                        Sign out

                    </button>

                </form>

            </li>

        </ul>

    </li>

}
else
{

    <li class="nav-item">

        <a class="cl-auth-link"
           asp-area="Identity"
           asp-page="/Account/Login">

            Sign in

        </a>

    </li>


    <li class="nav-item">

        <a class="cl-nav-button"
           asp-area="Identity"
           asp-page="/Account/Register">

            Get started

        </a>

    </li>

}