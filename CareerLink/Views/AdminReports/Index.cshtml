@model CareerLink.ViewModels.AdminReportsViewModel

@{
    ViewData["Title"] = "Reports & Statistics";
}

<div class="cl-admin-page">

    <div class="cl-admin-page-header">

        <div>
            <div class="cl-admin-eyebrow">
                <i class="bi bi-bar-chart"></i>
                PLATFORM ANALYTICS
            </div>

            <h1 class="cl-admin-title">
                Reports &amp; Statistics
            </h1>

            <p class="cl-admin-subtitle">
                Overview of CareerLink platform activity.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="cl-soft-button">
            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>

    </div>

    <!-- Users -->

    <div class="cl-admin-report-card">

        <div class="cl-admin-report-header">
            <div class="cl-admin-report-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <h2>User Statistics</h2>
                <p>Accounts and user activity.</p>
            </div>
        </div>

        <div class="cl-admin-report-grid">

            <div class="cl-admin-report-stat">
                <span>Total Users</span>
                <strong>@Model.TotalUsers</strong>
            </div>

            <div class="cl-admin-report-stat">
                <span>Job Seekers</span>
                <strong>@Model.JobSeekers</strong>
            </div>

            <div class="cl-admin-report-stat">
                <span>Recruiters</span>
                <strong>@Model.Recruiters</strong>
            </div>

            <div class="cl-admin-report-stat">
                <span>Active Users</span>
                <strong>@Model.ActiveUsers</strong>
            </div>

            <div class="cl-admin-report-stat">
                <span>Inactive Users</span>
                <strong>@Model.InactiveUsers</strong>
            </div>

        </div>

    </div>

    <!-- Companies and Jobs -->

    <div class="cl-admin-report-card">

        <div class="cl-admin-report-header">
            <div class="cl-admin-report-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <h2>Company &amp; Job Statistics</h2>
                <p>Companies and job posting activity.</p>
            </div>
        </div>

        <div class="cl-admin-report-grid">

            <div class="cl-admin-report-stat">
                <span>Companies</span>
                <strong>@Model.TotalCompanies</strong>
            </div>

            <div class="cl-admin-report-stat">
                <span>Total Jobs</span>
                <strong>@Model.TotalJobs</strong>
            </div>

            <div class="cl-admin-report-stat">
                <span>Active Jobs</span>
                <strong>@Model.ActiveJobs</strong>
            </div>

            <div class="cl-admin-report-stat">
                <span>Closed Jobs</span>
                <strong>@Model.ClosedJobs</strong>
            </div>

        </div>

    </div>

    <!-- Applications -->

    <div class="cl-admin-report-card">

        <div class="cl-admin-report-header">
            <div class="cl-admin-report-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div>
                <h2>Application Statistics</h2>
                <p>Application pipeline by status.</p>
            </div>

            <div class="cl-admin-report-total">
                <span>Total Applications</span>
                <strong>@Model.TotalApplications</strong>
            </div>
        </div>

        <div class="table-responsive">

            <table class="table cl-admin-report-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Status</th>
                        <th class="text-end">Applications</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Applied</td>
                        <td>@Model.AppliedApplications</td>
                    </tr>

                    <tr>
                        <td>Under Review</td>
                        <td>@Model.UnderReviewApplications</td>
                    </tr>

                    <tr>
                        <td>Shortlisted</td>
                        <td>@Model.ShortlistedApplications</td>
                    </tr>

                    <tr>
                        <td>Interview</td>
                        <td>@Model.InterviewApplications</td>
                    </tr>

                    <tr>
                        <td>Selected</td>
                        <td>@Model.SelectedApplications</td>
                    </tr>

                    <tr>
                        <td>Rejected</td>
                        <td>@Model.RejectedApplications</td>
                    </tr>

                    <tr>
                        <td>Withdrawn</td>
                        <td>@Model.WithdrawnApplications</td>
                    </tr>
                </tbody>

            </table>

        </div>

    </div>

    <!-- Interviews -->

    <div class="cl-admin-report-card">

        <div class="cl-admin-report-header">
            <div class="cl-admin-report-icon">
                <i class="bi bi-calendar2-event"></i>
            </div>

            <div>
                <h2>Interview Statistics</h2>
                <p>Interview activity by status.</p>
            </div>

            <div class="cl-admin-report-total">
                <span>Total Interviews</span>
                <strong>@Model.TotalInterviews</strong>
            </div>
        </div>

        <div class="table-responsive">

            <table class="table cl-admin-report-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Status</th>
                        <th class="text-end">Interviews</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Scheduled</td>
                        <td>@Model.ScheduledInterviews</td>
                    </tr>

                    <tr>
                        <td>Completed</td>
                        <td>@Model.CompletedInterviews</td>
                    </tr>

                    <tr>
                        <td>Cancelled</td>
                        <td>@Model.CancelledInterviews</td>
                    </tr>

                    <tr>
                        <td>Rescheduled</td>
                        <td>@Model.RescheduledInterviews</td>
                    </tr>
                </tbody>

            </table>

        </div>

    </div>

</div>