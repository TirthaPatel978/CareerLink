@model CareerLink.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="cl-admin-page">

    <!-- Header -->
    <div class="cl-admin-page-header">

        <div>
            <div class="cl-admin-eyebrow">
                <i class="bi bi-speedometer2"></i>
                ADMINISTRATION
            </div>

            <h1 class="cl-admin-title">
                Admin Dashboard
            </h1>

            <p class="cl-admin-subtitle">
                Monitor and manage CareerLink from one place.
            </p>
        </div>

    </div>


    <!-- Main statistics -->
    <div class="cl-admin-stats-grid">

        <div class="cl-admin-stat-card">
            <div class="cl-admin-stat-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <div class="cl-admin-stat-label">
                    Total Users
                </div>

                <div class="cl-admin-stat-value">
                    @Model.TotalUsers
                </div>
            </div>
        </div>


        <div class="cl-admin-stat-card">
            <div class="cl-admin-stat-icon">
                <i class="bi bi-person-badge"></i>
            </div>

            <div>
                <div class="cl-admin-stat-label">
                    Job Seekers
                </div>

                <div class="cl-admin-stat-value">
                    @Model.JobSeekers
                </div>
            </div>
        </div>


        <div class="cl-admin-stat-card">
            <div class="cl-admin-stat-icon">
                <i class="bi bi-briefcase"></i>
            </div>

            <div>
                <div class="cl-admin-stat-label">
                    Recruiters
                </div>

                <div class="cl-admin-stat-value">
                    @Model.Recruiters
                </div>
            </div>
        </div>


        <div class="cl-admin-stat-card">
            <div class="cl-admin-stat-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <div class="cl-admin-stat-label">
                    Companies
                </div>

                <div class="cl-admin-stat-value">
                    @Model.Companies
                </div>
            </div>
        </div>


        <div class="cl-admin-stat-card">
            <div class="cl-admin-stat-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div>
                <div class="cl-admin-stat-label">
                    Total Jobs
                </div>

                <div class="cl-admin-stat-value">
                    @Model.Jobs
                </div>
            </div>
        </div>


        <div class="cl-admin-stat-card">
            <div class="cl-admin-stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <div class="cl-admin-stat-label">
                    Active Jobs
                </div>

                <div class="cl-admin-stat-value">
                    @Model.ActiveJobs
                </div>
            </div>
        </div>


        <div class="cl-admin-stat-card">
            <div class="cl-admin-stat-icon">
                <i class="bi bi-send"></i>
            </div>

            <div>
                <div class="cl-admin-stat-label">
                    Applications
                </div>

                <div class="cl-admin-stat-value">
                    @Model.Applications
                </div>
            </div>
        </div>


        <div class="cl-admin-stat-card">
            <div class="cl-admin-stat-icon">
                <i class="bi bi-calendar-event"></i>
            </div>

            <div>
                <div class="cl-admin-stat-label">
                    Interviews
                </div>

                <div class="cl-admin-stat-value">
                    @Model.Interviews
                </div>
            </div>
        </div>

    </div>


    <!-- User status -->
    <div class="cl-admin-section-card">

        <div class="cl-admin-section-header">

            <div>
                <div class="cl-admin-eyebrow">
                    <i class="bi bi-person-check"></i>
                    ACCOUNT STATUS
                </div>

                <h2>
                    User Activity
                </h2>

                <p>
                    Overview of active and inactive CareerLink accounts.
                </p>
            </div>

        </div>


        <div class="cl-admin-user-status-grid">

            <div class="cl-admin-status-card">

                <div class="cl-admin-status-icon cl-admin-status-active">
                    <i class="bi bi-person-check"></i>
                </div>

                <div>
                    <div class="cl-admin-status-label">
                        Active Users
                    </div>

                    <div class="cl-admin-status-value">
                        @Model.ActiveUsers
                    </div>
                </div>

            </div>


            <div class="cl-admin-status-card">

                <div class="cl-admin-status-icon cl-admin-status-inactive">
                    <i class="bi bi-person-x"></i>
                </div>

                <div>
                    <div class="cl-admin-status-label">
                        Inactive Users
                    </div>

                    <div class="cl-admin-status-value">
                        @Model.InactiveUsers
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Management -->
    <div class="cl-admin-section-card">

        <div class="cl-admin-section-header">

            <div>
                <div class="cl-admin-eyebrow">
                    <i class="bi bi-grid"></i>
                    MANAGEMENT
                </div>

                <h2>
                    Administration Tools
                </h2>

                <p>
                    Manage users, companies, jobs, skills and platform reports.
                </p>
            </div>

        </div>


        <div class="cl-admin-management-grid">

            <!-- Users -->
            <a asp-controller="AdminUsers"
               asp-action="Index"
               class="cl-admin-management-card">

                <div class="cl-admin-management-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div class="cl-admin-management-content">
                    <h3>
                        Manage Users
                    </h3>

                    <p>
                        View user accounts and activate or deactivate users.
                    </p>
                </div>

                <i class="bi bi-arrow-right cl-admin-management-arrow"></i>

            </a>


            <!-- Companies -->
            <a asp-controller="AdminCompanies"
               asp-action="Index"
               class="cl-admin-management-card">

                <div class="cl-admin-management-icon">
                    <i class="bi bi-building"></i>
                </div>

                <div class="cl-admin-management-content">
                    <h3>
                        Manage Companies
                    </h3>

                    <p>
                        View registered companies and their activity.
                    </p>
                </div>

                <i class="bi bi-arrow-right cl-admin-management-arrow"></i>

            </a>


            <!-- Jobs -->
            <a asp-controller="AdminJobs"
               asp-action="Index"
               class="cl-admin-management-card">

                <div class="cl-admin-management-icon">
                    <i class="bi bi-briefcase"></i>
                </div>

                <div class="cl-admin-management-content">
                    <h3>
                        Manage Jobs
                    </h3>

                    <p>
                        Monitor job postings and manage their status.
                    </p>
                </div>

                <i class="bi bi-arrow-right cl-admin-management-arrow"></i>

            </a>


            <!-- Skills -->
            <a asp-controller="AdminSkills"
               asp-action="Index"
               class="cl-admin-management-card">

                <div class="cl-admin-management-icon">
                    <i class="bi bi-stars"></i>
                </div>

                <div class="cl-admin-management-content">
                    <h3>
                        Manage Skills
                    </h3>

                    <p>
                        Add, edit and manage platform skills.
                    </p>
                </div>

                <i class="bi bi-arrow-right cl-admin-management-arrow"></i>

            </a>


            <!-- Reports -->
            <a asp-controller="AdminReports"
               asp-action="Index"
               class="cl-admin-management-card">

                <div class="cl-admin-management-icon">
                    <i class="bi bi-bar-chart"></i>
                </div>

                <div class="cl-admin-management-content">
                    <h3>
                        Reports &amp; Statistics
                    </h3>

                    <p>
                        Review platform statistics and application activity.
                    </p>
                </div>

                <i class="bi bi-arrow-right cl-admin-management-arrow"></i>

            </a>

        </div>

    </div>

</div>