@model IEnumerable<CareerLink.ViewModels.SavedJobViewModel>

@{
    ViewData["Title"] = "Saved Jobs";
}

<div class="cl-saved-page">

    <!-- Page Header -->
    <div class="cl-saved-header">

        <div class="cl-saved-heading">

            <div class="cl-saved-icon">
                ♡
            </div>

            <div>
                <div class="cl-dashboard-eyebrow">
                    JOB SEEKER
                </div>

                <h1>Saved Jobs</h1>

                <p>
                    Keep track of opportunities you want to explore later.
                </p>
            </div>

        </div>

        <a asp-controller="Jobs"
           asp-action="Index"
           class="cl-saved-browse-btn">
            Browse Jobs
        </a>

    </div>


    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="cl-saved-empty">

            <div class="cl-saved-empty-icon">
                ♡
            </div>

            <h2>No saved jobs yet</h2>

            <p>
                When you find a job you're interested in,
                save it and it will appear here so you can
                easily come back to it later.
            </p>

            <a asp-controller="Jobs"
               asp-action="Index"
               class="cl-saved-primary-btn">
                Explore Jobs
            </a>

        </div>
    }
    else
    {
        <!-- Saved Jobs -->
        <div class="cl-saved-list">

            @foreach (var job in Model)
            {
                <article class="cl-saved-card">

                    <!-- Top Section -->
                    <div class="cl-saved-card-top">

                        <div class="cl-saved-job-main">

                            <div class="cl-saved-company-icon">
                                @if (!string.IsNullOrWhiteSpace(job.CompanyName))
                                {
                                    @job.CompanyName.Substring(
                                        0,
                                        1
                                    ).ToUpper()
                                }
                                else
                                {
                                    <span>J</span>
                                }
                            </div>

                            <div>

                                <h2 class="cl-saved-job-title">
                                    @job.Title
                                </h2>

                                <div class="cl-saved-company">
                                    @job.CompanyName
                                </div>

                            </div>

                        </div>

                        @if (job.IsRemote)
                        {
                            <span class="cl-saved-remote">
                                Remote
                            </span>
                        }

                    </div>


                    <!-- Job Information -->
                    <div class="cl-saved-meta">

                        <div class="cl-saved-meta-item">

                            <span class="cl-saved-meta-icon">
                                📍
                            </span>

                            <span>
                                @if (!string.IsNullOrWhiteSpace(job.Location))
                                {
                                    @job.Location
                                }
                                else
                                {
                                    <span>Location not specified</span>
                                }
                            </span>

                        </div>


                        <div class="cl-saved-meta-item">

                            <span class="cl-saved-meta-icon">
                                💼
                            </span>

                            <span>
                                @job.JobType
                            </span>

                        </div>


                        @if (job.SalaryMin.HasValue ||
                             job.SalaryMax.HasValue)
                        {
                            <div class="cl-saved-meta-item">

                                <span class="cl-saved-meta-icon">
                                    💰
                                </span>

                                <span>

                                    @if (job.SalaryMin.HasValue &&
                                         job.SalaryMax.HasValue)
                                    {
                                        @($"{job.SalaryMin:N0} - {job.SalaryMax:N0}")
                                    }
                                    else if (job.SalaryMin.HasValue)
                                    {
                                        @($"From {job.SalaryMin:N0}")
                                    }
                                    else
                                    {
                                        @($"Up to {job.SalaryMax:N0}")
                                    }

                                </span>

                            </div>
                        }

                    </div>


                    <!-- Additional Information -->
                    <div class="cl-saved-details">

                        <div class="cl-saved-detail">

                            <span class="cl-saved-detail-label">
                                Saved on
                            </span>

                            <span class="cl-saved-detail-value">
                                @job.SavedAt
                                .ToLocalTime()
                                .ToString("dd MMM yyyy")
                            </span>

                        </div>


                        @if (job.ApplicationDeadline.HasValue)
                        {
                            <div class="cl-saved-detail">

                                <span class="cl-saved-detail-label">
                                    Application deadline
                                </span>

                                <span class="cl-saved-detail-value cl-saved-deadline">

                                    @job.ApplicationDeadline.Value
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy")

                                </span>

                            </div>
                        }

                    </div>


                    <!-- Actions -->
                    <div class="cl-saved-actions">

                        <a asp-controller="Jobs"
                           asp-action="Details"
                           asp-route-id="@job.JobId"
                           class="cl-saved-view-btn">
                            View Job
                        </a>

                        <form asp-controller="SavedJobs"
                              asp-action="Remove"
                              method="post"
                              class="cl-saved-remove-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="jobId"
                                   value="@job.JobId" />

                            <button type="submit"
                                    class="cl-saved-remove-btn">
                                Remove
                            </button>

                        </form>

                    </div>

                </article>
            }

        </div>
    }

</div>