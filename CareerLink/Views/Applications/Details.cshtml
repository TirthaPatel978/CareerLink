@model CareerLink.Models.Application

@{
    ViewData["Title"] = "Application Details";
}

<div class="container py-4">

    <!-- Back -->
    <div class="mb-3">

        <a asp-action="Index"
           class="text-decoration-none">
            ← Back to My Applications
        </a>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-1"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-4">

        <!-- Main Content -->
        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <!-- Header -->
                    <div class="d-flex justify-content-between
                        align-items-start mb-4">

                        <div>

                            <h1 class="fw-bold mb-1">
                                @Model.Job.Title
                            </h1>

                            <h5 class="text-muted">
                                @Model.Job.Company.Name
                            </h5>

                        </div>

                        @{
                            var badgeClass =
                                Model.Status switch
                                {
                                    CareerLink.Models.Enums
                                        .ApplicationStatus.Applied
                                        => "bg-primary",

                                    CareerLink.Models.Enums
                                        .ApplicationStatus.UnderReview
                                        => "bg-info",

                                    CareerLink.Models.Enums
                                        .ApplicationStatus.Shortlisted
                                        => "bg-success",

                                    CareerLink.Models.Enums
                                        .ApplicationStatus.Interview
                                        => "bg-warning text-dark",

                                    CareerLink.Models.Enums
                                        .ApplicationStatus.Selected
                                        => "bg-success",

                                    CareerLink.Models.Enums
                                        .ApplicationStatus.Rejected
                                        => "bg-danger",

                                    CareerLink.Models.Enums
                                        .ApplicationStatus.Withdrawn
                                        => "bg-secondary",

                                    _ => "bg-secondary"
                                };
                        }

                        <span class="badge @badgeClass fs-6">
                            @Model.Status
                        </span>

                    </div>

                    <hr />

                    <!-- Application Information -->
                    <h4 class="mt-4">
                        Application Information
                    </h4>

                    <div class="row mb-4">

                        <!-- Applied On -->
                        <div class="col-md-6 mb-3">

                            <strong>
                                Applied On
                            </strong>

                            <div class="text-muted">

                                @(
                                    Model.AppliedAt
                                        .ToLocalTime()
                                        .ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                )

                            </div>

                        </div>

                        <!-- Last Updated -->
                        <div class="col-md-6 mb-3">

                            <strong>
                                Last Updated
                            </strong>

                            <div class="text-muted">

                                @if (Model.UpdatedAt.HasValue)
                                {
                                    @(
                                        Model.UpdatedAt.Value
                                            .ToLocalTime()
                                            .ToString(
                                                "dd MMM yyyy, hh:mm tt")
                                    )
                                }
                                else
                                {
                                    <span>
                                        Not updated yet
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- Resume -->
                    <h4>
                        Resume
                    </h4>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.ResumePath))
                    {
                        <div class="card bg-light border-0 mb-4">

                            <div class="card-body">

                                <div class="d-flex
                                    align-items-center
                                    justify-content-between
                                    gap-3">

                                    <!-- Resume Info -->
                                    <div class="d-flex
                                        align-items-center">

                                        <div class="me-3">

                                            <i class="bi
                                                bi-file-earmark-person
                                                fs-2
                                                text-primary"></i>

                                        </div>

                                        <div>

                                            <strong>
                                                Submitted Resume
                                            </strong>

                                            <div class="small text-muted">
                                                Resume attached to this
                                                application
                                            </div>

                                        </div>

                                    </div>

                                    <!-- View Resume -->
                                    <a href="@Model.ResumePath"
                                       target="_blank"
                                       rel="noopener"
                                       class="btn btn-outline-primary">

                                        <i class="bi
                                            bi-file-earmark-pdf
                                            me-1"></i>

                                        View Resume

                                    </a>

                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4">

                            <i class="bi bi-exclamation-triangle me-1"></i>

                            No resume was submitted with this
                            application.

                        </div>
                    }

                    <!-- Cover Letter -->
                    <h4>
                        Cover Letter
                    </h4>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.CoverLetter))
                    {
                        <div class="card bg-light border-0">

                            <div class="card-body">

                                @Html.Raw(
                                    Model.CoverLetter
                                        .Replace(
                                            "\n",
                                            "<br />"))

                            </div>

                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            No cover letter was submitted.
                        </p>
                    }

                    <!-- Match Score -->
                    @if (Model.MatchScore.HasValue)
                    {
                        <h4 class="mt-4">
                            Match Score
                        </h4>

                        <div class="card bg-light border-0">

                            <div class="card-body">

                                <h3 class="mb-1">

                                    @Model.MatchScore.Value
                                        .ToString("0.##")%

                                </h3>

                                <p class="text-muted mb-0">
                                    This score will be calculated using
                                    CareerLink's rule-based matching system.
                                </p>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-4">

                            <i class="bi bi-info-circle me-1"></i>

                            Match score will be available after the
                            matching system is implemented.

                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">

            <!-- Job Information -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        Job Information
                    </h5>

                    <!-- Location -->
                    @if (!string.IsNullOrWhiteSpace(
                        Model.Job.Location))
                    {
                        <div class="mb-3">

                            <strong>
                                Location
                            </strong>

                            <div class="text-muted">
                                @Model.Job.Location
                            </div>

                        </div>
                    }

                    <!-- Job Type -->
                    <div class="mb-3">

                        <strong>
                            Job Type
                        </strong>

                        <div class="text-muted">
                            @Model.Job.JobType
                        </div>

                    </div>

                    <!-- View Job -->
                    <a asp-controller="Jobs"
                       asp-action="Details"
                       asp-route-id="@Model.JobId"
                       class="btn btn-outline-primary w-100">

                        <i class="bi bi-briefcase me-1"></i>

                        View Job

                    </a>

                </div>

            </div>

            <!-- Application Actions -->
            @if (Model.Status !=
                    CareerLink.Models.Enums.ApplicationStatus.Withdrawn &&
                Model.Status !=
                    CareerLink.Models.Enums.ApplicationStatus.Selected &&
                Model.Status !=
                    CareerLink.Models.Enums.ApplicationStatus.Rejected)
            {
                <div class="card shadow-sm">

                    <div class="card-body">

                        <h5 class="fw-bold">
                            Application Actions
                        </h5>

                        <p class="text-muted">
                            You can update your resume or cover letter
                            while this application is being considered.
                        </p>

                        <!-- Edit Application -->
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-primary w-100 mb-2">

                            <i class="bi bi-pencil me-1"></i>

                            Edit Application

                        </a>

                        <!-- Withdraw Application -->
                        <form asp-action="Withdraw"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('Are you sure you want to withdraw this application?');">

                                <i class="bi bi-x-circle me-1"></i>

                                Withdraw Application

                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>

    </div>

</div>