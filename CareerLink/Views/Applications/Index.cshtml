@model IEnumerable<CareerLink.Models.Application>

@{
    ViewData["Title"] = "My Applications";
}

<div class="container py-4">

    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <div>

            <h1 class="fw-bold">
                My Applications
            </h1>

            <p class="text-muted mb-0">
                Track the jobs you have applied for.
            </p>

        </div>

        <a asp-controller="Jobs"
           asp-action="Index"
           class="btn btn-primary">
            Browse Jobs
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4 class="mb-3">
                    No applications yet
                </h4>

                <p class="text-muted mb-4">
                    You haven't applied for any jobs yet.
                </p>

                <a asp-controller="Jobs"
                   asp-action="Index"
                   class="btn btn-primary">
                    Browse Jobs
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var application in Model)
            {
                <div class="col-12">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between
                                align-items-start">

                                <div>

                                    <h4 class="mb-1">
                                        @application.Job.Title
                                    </h4>

                                    <h6 class="text-muted mb-3">
                                        @application.Job.Company.Name
                                    </h6>

                                </div>

                                @{
                                    var badgeClass =
                                        application.Status switch
                                        {
                                            CareerLink.Models.Enums
                                                .ApplicationStatus.Applied
                                                => "bg-primary",

                                            CareerLink.Models.Enums
                                                .ApplicationStatus.UnderReview
                                                => "bg-info",

                                            CareerLink.Models.Enums
                                                .ApplicationStatus.Shortlisted
                                                => "bg-success",

                                            CareerLink.Models.Enums
                                                .ApplicationStatus.Interview
                                                => "bg-warning text-dark",

                                            CareerLink.Models.Enums
                                                .ApplicationStatus.Selected
                                                => "bg-success",

                                            CareerLink.Models.Enums
                                                .ApplicationStatus.Rejected
                                                => "bg-danger",

                                            CareerLink.Models.Enums
                                                .ApplicationStatus.Withdrawn
                                                => "bg-secondary",

                                            _ => "bg-secondary"
                                        };
                                }

                                <span class="badge @badgeClass">
                                    @application.Status
                                </span>

                            </div>

                            <div class="mb-3">

                                @if (!string.IsNullOrWhiteSpace(
                                    application.Job.Location))
                                {
                                    <span class="text-muted me-3">
                                        📍 @application.Job.Location
                                    </span>
                                }

                                <span class="text-muted">
                                    Applied:
                                    @application.AppliedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy")
                                </span>

                            </div>

                            @if (application.MatchScore.HasValue)
                            {
                                <div class="mb-3">

                                    <strong>
                                        Match Score:
                                    </strong>

                                    @application.MatchScore.Value
                                    .ToString("0.##")%

                                </div>
                            }

                            <a asp-action="Details"
                               asp-route-id="@application.Id"
                               class="btn btn-outline-primary">
                                View Application
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>