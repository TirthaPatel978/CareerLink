@model CareerLink.ViewModels.ApplicationViewModel

@{
    ViewData["Title"] = "Apply for Job";
}

<div class="container py-4">

    <div class="mb-3">

        <a asp-controller="Jobs"
           asp-action="Details"
           asp-route-id="@Model.JobId"
           class="text-decoration-none">
            ← Back to Job
        </a>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h1 class="fw-bold mb-2">
                        Apply for Job
                    </h1>

                    <p class="text-muted mb-4">
                        Submit your application for this position.
                    </p>

                    <div class="card bg-light border-0 mb-4">

                        <div class="card-body">

                            <h4 class="mb-1">
                                @Model.JobTitle
                            </h4>

                            <p class="text-muted mb-2">
                                @Model.CompanyName
                            </p>

                            @if (!string.IsNullOrWhiteSpace(Model.JobLocation))
                            {
                                <div class="small text-muted">
                                    📍 @Model.JobLocation
                                </div>
                            }

                            @if (Model.ApplicationDeadline.HasValue)
                            {
                                <div class="small text-muted mt-1">
                                    Application deadline:
                                    @(
                                        Model.ApplicationDeadline.Value
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy")
                                    )
                                </div>
                            }

                        </div>

                    </div>

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="JobId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">

                            <label asp-for="CoverLetter"
                                   class="form-label fw-bold">
                            </label>

                            <textarea asp-for="CoverLetter"
                                      class="form-control"
                                      rows="10"
                                      placeholder="Write a short cover letter explaining why you are interested in this position and why you would be a good fit.">
                            </textarea>

                            <div class="form-text">
                                Optional. Maximum 5000 characters.
                            </div>

                            <span asp-validation-for="CoverLetter"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2">

                            <a asp-controller="Jobs"
                               asp-action="Details"
                               asp-route-id="@Model.JobId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Submit Application
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}