@model CareerLink.ViewModels.RecruiterDashboardViewModel

@{
    ViewData["Title"] = "Recruiter Dashboard";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="mb-1">
                Recruiter Dashboard
            </h1>

            <p class="text-muted mb-0">
                Welcome, @Model.RecruiterName
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
            {
                <p class="text-muted mb-0">
                    Company: @Model.CompanyName
                </p>
            }

        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Recruiter"
               asp-action="Profile"
               class="btn btn-outline-primary">
                Recruiter Profile
            </a>

            <a asp-controller="Company"
               asp-action="Profile"
               class="btn btn-outline-primary">
                Company Profile
            </a>

            <a asp-controller="RecruiterJobs"
               asp-action="Index"
               class="btn btn-primary">
                Manage Jobs
            </a>

        </div>

    </div>

    @if (string.IsNullOrWhiteSpace(Model.CompanyName))
    {
        <div class="alert alert-warning">

            <h5 class="alert-heading">
                Company profile not set up
            </h5>

            <p class="mb-2">
                You need to create your company profile before
                managing jobs.
            </p>

            <a asp-controller="Company"
               asp-action="Profile"
               class="btn btn-warning">
                Create Company Profile
            </a>

        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Jobs
                    </h6>

                    <h2 class="mb-0">
                        @Model.TotalJobs
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Active Jobs
                    </h6>

                    <h2 class="mb-0">
                        @Model.ActiveJobs
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Closed Jobs
                    </h6>

                    <h2 class="mb-0">
                        @Model.ClosedJobs
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Applications
                    </h6>

                    <h2 class="mb-0">
                        @Model.TotalApplications
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">

            <h4 class="mb-0">
                Recruiter Actions
            </h4>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">

                    <a asp-controller="Company"
                       asp-action="Profile"
                       class="btn btn-outline-primary w-100">
                        Manage Company
                    </a>

                </div>

                <div class="col-md-3">

                    <a asp-controller="Recruiter"
                       asp-action="Profile"
                       class="btn btn-outline-primary w-100">
                        Manage Profile
                    </a>

                </div>

                <div class="col-md-3">

                    <a asp-controller="RecruiterJobs"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100">
                        Manage Jobs
                    </a>

                </div>

                <div class="col-md-3">

                    <a asp-controller="RecruiterJobs"
                       asp-action="Create"
                       class="btn btn-primary w-100">
                        Create Job
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>