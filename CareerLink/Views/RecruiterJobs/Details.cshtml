@model CareerLink.Models.Job

@{
    ViewData["Title"] = "Job Details";

    var applicationCount = ViewBag.ApplicationCount is int count
        ? count
        : 0;
}

<div class="container py-4">

    <div class="card shadow-sm">

        <!-- Header -->
        <div class="card-header d-flex justify-content-between align-items-start">
            <div>
                <h2 class="mb-1">@Model.Title</h2>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="text-muted">
                        @Model.Description
                    </div>
                }
            </div>

            @if (Model.IsActive)
            {
                <span class="badge bg-success">
                    Active
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    Closed
                </span>
            }
        </div>

        <div class="card-body">

            <!-- Job information -->
            <div class="row g-4">

                <div class="col-md-6">
                    <strong>Job Type</strong>
                    <div>
                        @Model.JobType
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Location</strong>
                    <div>
                        @(Model.IsRemote
                            ? "Remote"
                            : string.IsNullOrWhiteSpace(Model.Location)
                                ? "Not specified"
                                : Model.Location)
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Salary</strong>
                    <div>
                        @if (Model.SalaryMin.HasValue && Model.SalaryMax.HasValue)
                        {
                            @($"{Model.SalaryMin.Value:N2} - {Model.SalaryMax.Value:N2}")
                        }
                        else if (Model.SalaryMin.HasValue)
                        {
                            @($"{Model.SalaryMin.Value:N2}+")
                        }
                        else if (Model.SalaryMax.HasValue)
                        {
                            @($"Up to {Model.SalaryMax.Value:N2}")
                        }
                        else
                        {
                            <span class="text-muted">
                                Not specified
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <strong>Experience Required</strong>
                    <div>
                        @Model.ExperienceRequired years
                    </div>
                </div>

            </div>

            <!-- Description -->
            <div class="mt-4">
                <h4>Description</h4>

                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted">
                        No description provided.
                    </p>
                }
                else
                {
                    <p style="white-space: pre-line;">
                        @Model.Description
                    </p>
                }
            </div>

            <!-- Education -->
            <div class="mt-4">
                <h4>Education Requirement</h4>

                @if (string.IsNullOrWhiteSpace(Model.EducationRequirement))
                {
                    <p class="text-muted">
                        No specific education requirement.
                    </p>
                }
                else
                {
                    <p>
                        @Model.EducationRequirement
                    </p>
                }
            </div>

            <!-- Deadline -->
            <div class="mt-4">
                <h4>Application Deadline</h4>

                @if (Model.ApplicationDeadline.HasValue)
                {
                    <p>
                        @Model.ApplicationDeadline.Value.ToString("dd MMM yyyy")
                    </p>
                }
                else
                {
                    <p class="text-muted">
                        No deadline specified.
                    </p>
                }
            </div>

            <!-- Matching weights -->
            <div class="mt-4">
                <h4>Matching Weights</h4>

                <div class="row">

                    <div class="col-md-3">
                        <strong>Skills</strong>
                        <div>
                            @Model.SkillWeight.ToString("0.##")%
                        </div>
                    </div>

                    <div class="col-md-3">
                        <strong>Education</strong>
                        <div>
                            @Model.EducationWeight.ToString("0.##")%
                        </div>
                    </div>

                    <div class="col-md-3">
                        <strong>Experience</strong>
                        <div>
                            @Model.ExperienceWeight.ToString("0.##")%
                        </div>
                    </div>

                    <div class="col-md-3">
                        <strong>Location</strong>
                        <div>
                            @Model.LocationWeight.ToString("0.##")%
                        </div>
                    </div>

                </div>
            </div>

            <!-- Applications -->
            <div class="alert alert-light border mt-4">
                <strong>Applications received:</strong>
                @applicationCount
            </div>

            <!-- Actions -->
            <div class="d-flex flex-wrap gap-2 mt-3">

                <a asp-controller="RecruiterJobs"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit Job
                </a>

                <a asp-controller="RecruiterApplications"
                   asp-action="Index"
                   asp-route-jobId="@Model.Id"
                   class="btn btn-outline-primary">
                    View Applicants
                </a>

                @if (Model.IsActive)
                {
                    <form asp-controller="RecruiterJobs"
                          asp-action="ToggleStatus"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger">
                            Close Job
                        </button>

                    </form>
                }
                else
                {
                    <form asp-controller="RecruiterJobs"
                          asp-action="ToggleStatus"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-success">
                            Reopen Job
                        </button>

                    </form>
                }

                <a asp-controller="RecruiterJobs"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Jobs
                </a>

            </div>

        </div>
    </div>
</div>