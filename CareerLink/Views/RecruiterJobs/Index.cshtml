@model IEnumerable<CareerLink.ViewModels.RecruiterJobListViewModel>

@{
    ViewData["Title"] = "Manage Jobs";
}

<div class="cl-recruiter-page cl-job-management-page">

    <div class="cl-profile-page-header">
        <div>
            <div class="cl-recruiter-eyebrow">
                <i class="bi bi-briefcase"></i>
                JOB MANAGEMENT
            </div>

            <h1 class="cl-profile-page-title">
                Manage Jobs
            </h1>

            <p class="cl-profile-page-subtitle">
                Create, edit, view, and manage your company's job postings.
            </p>
        </div>

        <a asp-controller="RecruiterJobs"
           asp-action="Create"
           class="cl-purple-button">
            <i class="bi bi-plus-lg"></i>
            Create New Job
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cl-profile-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="cl-job-warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["WarningMessage"]</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="cl-profile-card cl-job-empty-state">

            <div class="cl-job-empty-icon">
                <i class="bi bi-briefcase"></i>
            </div>

            <h2>No jobs posted yet</h2>

            <p>
                Create your first job posting to start receiving applications
                from candidates.
            </p>

            <a asp-controller="RecruiterJobs"
               asp-action="Create"
               class="cl-purple-button">
                <i class="bi bi-plus-lg"></i>
                Create Your First Job
            </a>

        </div>
    }
    else
    {
        <div class="cl-profile-card cl-jobs-table-card">

            <div class="cl-jobs-table-header">

                <div>
                    <h2>Your Job Postings</h2>
                    <p>
                        @Model.Count() job posting@(Model.Count() == 1 ? "" : "s") in your company.
                    </p>
                </div>

                <div class="cl-job-count-badge">
                    <i class="bi bi-briefcase"></i>
                    @Model.Count()
                </div>

            </div>

            <div class="table-responsive">

                <table class="table cl-jobs-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Job</th>
                            <th>Type</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Applications</th>
                            <th>Deadline</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var job in Model)
                        {
                            <tr>

                                <td>
                                    <div class="cl-job-title-cell">
                                        <div class="cl-job-icon">
                                            <i class="bi bi-briefcase"></i>
                                        </div>

                                        <div>
                                            <strong>@job.Title</strong>

                                            <span>
                                                Posted
                                                @job.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="cl-job-type-badge">
                                        @job.JobType
                                    </span>
                                </td>

                                <td>
                                    @if (job.IsRemote)
                                    {
                                        <span class="cl-location-badge">
                                            <i class="bi bi-globe2"></i>
                                            Remote
                                        </span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(job.Location))
                                    {
                                        <span class="cl-location-text">
                                            <i class="bi bi-geo-alt"></i>
                                            @job.Location
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not specified
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (job.IsActive)
                                    {
                                        <span class="cl-status-badge cl-status-active">
                                            <span></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cl-status-badge cl-status-closed">
                                            <span></span>
                                            Closed
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="cl-application-count">
                                        <i class="bi bi-people"></i>
                                        @job.ApplicationCount
                                    </span>
                                </td>

                                <td>
                                    @if (job.ApplicationDeadline.HasValue)
                                    {
                                        <span class="cl-deadline">
                                            @job.ApplicationDeadline.Value.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No deadline
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="cl-job-actions">

                                        <a asp-controller="RecruiterJobs"
                                           asp-action="Details"
                                           asp-route-id="@job.Id"
                                           class="cl-job-action-button"
                                           title="View job">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="RecruiterApplications"
                                           asp-action="Index"
                                           asp-route-jobId="@job.Id"
                                           class="cl-job-action-button"
                                           title="View applicants">
                                            <i class="bi bi-people"></i>
                                        </a>

                                        <a asp-controller="RecruiterJobs"
                                           asp-action="Edit"
                                           asp-route-id="@job.Id"
                                           class="cl-job-action-button"
                                           title="Edit job">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-controller="RecruiterJobs"
                                              asp-action="ToggleStatus"
                                              asp-route-id="@job.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            @if (job.IsActive)
                                            {
                                                <button type="submit"
                                                        class="cl-job-action-button cl-job-action-danger"
                                                        title="Close job">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="cl-job-action-button cl-job-action-success"
                                                        title="Reopen job">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                </button>
                                            }

                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }

</div>