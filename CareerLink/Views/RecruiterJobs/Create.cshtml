@model CareerLink.ViewModels.RecruiterJobViewModel

@{
    ViewData["Title"] = "Create Job";
}

<div class="cl-recruiter-page">

    <div class="cl-profile-page-header">
        <div>
            <div class="cl-recruiter-eyebrow">
                <i class="bi bi-plus-circle"></i>
                JOB MANAGEMENT
            </div>

            <h1 class="cl-profile-page-title">
                Create Job
            </h1>

            <p class="cl-profile-page-subtitle">
                Publish a new opportunity for candidates to discover and apply.
            </p>
        </div>

        <div>
            <a asp-controller="RecruiterJobs"
               asp-action="Index"
               class="cl-soft-button">
                <i class="bi bi-arrow-left"></i>
                Back to Jobs
            </a>
        </div>
    </div>

    <div class="cl-profile-card">

        <div class="cl-profile-card-header">
            <div class="cl-profile-card-icon">
                <i class="bi bi-briefcase"></i>
            </div>

            <div>
                <h2>Job Details</h2>
                <p>
                    Add the information candidates will see when viewing this job.
                </p>
            </div>
        </div>

        <div class="cl-profile-card-body">

            <form asp-controller="RecruiterJobs"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="cl-profile-validation">
                </div>

                <div class="row g-4">

                    <div class="col-12">

                        <label asp-for="Title"
                               class="form-label">
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="e.g. ASP.NET Core Developer" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Describe the role, responsibilities and what the candidate will work on.">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="JobType"
                               class="form-label">
                        </label>

                        <select asp-for="JobType"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<CareerLink.Models.Enums.JobType>()">
                        </select>

                        <span asp-validation-for="JobType"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Location"
                               class="form-label">
                        </label>

                        <input asp-for="Location"
                               class="form-control"
                               placeholder="e.g. Ahmedabad, Gujarat" />

                        <span asp-validation-for="Location"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="SalaryMin"
                               class="form-label">
                        </label>

                        <input asp-for="SalaryMin"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="Minimum salary" />

                        <span asp-validation-for="SalaryMin"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="SalaryMax"
                               class="form-label">
                        </label>

                        <input asp-for="SalaryMax"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="Maximum salary" />

                        <span asp-validation-for="SalaryMax"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ExperienceRequired"
                               class="form-label">
                        </label>

                        <input asp-for="ExperienceRequired"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               placeholder="e.g. 2" />

                        <span asp-validation-for="ExperienceRequired"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="EducationRequirement"
                               class="form-label">
                        </label>

                        <input asp-for="EducationRequirement"
                               class="form-control"
                               placeholder="e.g. Bachelor's degree in Computer Science" />

                        <span asp-validation-for="EducationRequirement"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ApplicationDeadline"
                               class="form-label">
                        </label>

                        <input asp-for="ApplicationDeadline"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="ApplicationDeadline"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 d-flex align-items-end">

                        <div class="form-check cl-profile-checkbox">

                            <input asp-for="IsRemote"
                                   class="form-check-input" />

                            <label asp-for="IsRemote"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>

                </div>

                <div class="cl-profile-section-divider"></div>

                <div class="cl-profile-card-header px-0">
                    <div class="cl-profile-card-icon">
                        <i class="bi bi-bar-chart"></i>
                    </div>

                    <div>
                        <h2>Matching Weights</h2>
                        <p>
                            Set how much each factor contributes to the candidate matching score.
                            The total must equal 100%.
                        </p>
                    </div>
                </div>

                <div class="row g-4 mt-1">

                    <div class="col-md-6">

                        <label asp-for="SkillWeight"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <input asp-for="SkillWeight"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   max="100" />

                            <span class="input-group-text">%</span>

                        </div>

                        <span asp-validation-for="SkillWeight"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="EducationWeight"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <input asp-for="EducationWeight"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   max="100" />

                            <span class="input-group-text">%</span>

                        </div>

                        <span asp-validation-for="EducationWeight"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ExperienceWeight"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <input asp-for="ExperienceWeight"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   max="100" />

                            <span class="input-group-text">%</span>

                        </div>

                        <span asp-validation-for="ExperienceWeight"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="LocationWeight"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <input asp-for="LocationWeight"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   max="100" />

                            <span class="input-group-text">%</span>

                        </div>

                        <span asp-validation-for="LocationWeight"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="cl-profile-tip mt-4">

                    <i class="bi bi-lightbulb"></i>

                    <div>
                        <strong>Matching tip</strong>
                        <p>
                            The default weighting is Skills 50%, Education 20%,
                            Experience 20%, and Location 10%.
                        </p>
                    </div>

                </div>

                <div class="cl-profile-form-footer">

                    <a asp-controller="RecruiterJobs"
                       asp-action="Index"
                       class="cl-soft-button">
                        Cancel
                    </a>

                    <button type="submit"
                            class="cl-purple-button">
                        <i class="bi bi-check-circle"></i>
                        Create Job
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}