@model CareerLink.ViewModels.JobSeekerDashboardViewModel

@{
    ViewData["Title"] = "Job Seeker Dashboard";
}

<div class="container py-4">

    <!-- Welcome -->
    <div class="mb-4">

        <h1 class="fw-bold">
            Welcome, @Model.FullName
        </h1>

        @if (!string.IsNullOrWhiteSpace(Model.ProfessionalTitle))
        {
            <p class="lead text-muted mb-1">
                @Model.ProfessionalTitle
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Location))
        {
            <p class="text-muted">
                📍 @Model.Location
            </p>
        }

    </div>

    <!-- Profile Summary -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center mb-3">

                <h4 class="fw-bold mb-0">
                    Profile Summary
                </h4>

                <a asp-controller="JobSeeker"
                   asp-action="Profile"
                   class="btn btn-outline-primary btn-sm">
                    View Profile
                </a>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Summary))
            {
                <p class="text-muted mb-0">
                    @Model.Summary
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    You haven't added a professional summary yet.
                </p>
            }

        </div>

    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h2 class="fw-bold">
                        @Model.SkillCount
                    </h2>

                    <p class="text-muted mb-0">
                        Skills
                    </p>

                    <a asp-controller="Skills"
                       asp-action="Index"
                       class="small text-decoration-none">
                        Manage Skills
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h2 class="fw-bold">
                        @Model.EducationCount
                    </h2>

                    <p class="text-muted mb-0">
                        Education
                    </p>

                    <a asp-controller="Education"
                       asp-action="Index"
                       class="small text-decoration-none">
                        Manage Education
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h2 class="fw-bold">
                        @Model.ExperienceCount
                    </h2>

                    <p class="text-muted mb-0">
                        Experience
                    </p>

                    <a asp-controller="Experience"
                       asp-action="Index"
                       class="small text-decoration-none">
                        Manage Experience
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h2 class="fw-bold">
                        @Model.ProjectCount
                    </h2>

                    <p class="text-muted mb-0">
                        Projects
                    </p>

                    <a asp-controller="Project"
                       asp-action="Index"
                       class="small text-decoration-none">
                        Manage Projects
                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Additional Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h2 class="fw-bold">
                        @Model.CertificationCount
                    </h2>

                    <p class="text-muted mb-2">
                        Certifications
                    </p>

                    <a asp-controller="Certification"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-sm">
                        View Certifications
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h2 class="fw-bold">
                        @Model.SavedJobCount
                    </h2>

                    <p class="text-muted mb-2">
                        Saved Jobs
                    </p>

                    <a asp-controller="SavedJobs"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-sm">
                        View Saved Jobs
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h2 class="fw-bold">
                        @Model.ApplicationCount
                    </h2>

                    <p class="text-muted mb-2">
                        Applications
                    </p>

                    <span class="text-muted small">
                        Application tracking will be available
                        through the application module.
                    </span>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h4 class="fw-bold mb-3">
                Quick Actions
            </h4>

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Jobs"
                   asp-action="Index"
                   class="btn btn-primary">
                    Browse Jobs
                </a>

                <a asp-controller="SavedJobs"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Saved Jobs
                </a>

                <a asp-controller="JobSeeker"
                   asp-action="Profile"
                   class="btn btn-outline-secondary">
                    My Profile
                </a>

                <a asp-controller="Skills"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Manage Skills
                </a>

            </div>

        </div>

    </div>

    <!-- Recent Jobs -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center mb-3">

                <h4 class="fw-bold mb-0">
                    Recent Jobs
                </h4>

                <a asp-controller="Jobs"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">
                    View All Jobs
                </a>

            </div>

            @if (!Model.RecentJobs.Any())
            {
                <p class="text-muted mb-0">
                    No jobs are currently available.
                </p>
            }
            else
            {
                <div class="row g-3">

                    @foreach (var job in Model.RecentJobs)
                    {
                        <div class="col-12">

                            <div class="border rounded p-3">

                                <div class="d-flex
                                    justify-content-between
                                    align-items-start">

                                    <div>

                                        <h5 class="mb-1">
                                            @job.Title
                                        </h5>

                                        <p class="text-muted mb-2">
                                            @job.CompanyName
                                        </p>

                                    </div>

                                    @if (job.IsRemote)
                                    {
                                        <span class="badge bg-success">
                                            Remote
                                        </span>
                                    }

                                </div>

                                <div class="mb-2">

                                    <span class="badge bg-primary me-2">
                                        @job.JobType
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(
                                        job.Location))
                                    {
                                        <span class="text-muted">
                                            📍 @job.Location
                                        </span>
                                    }

                                </div>

                                <a asp-controller="Jobs"
                                   asp-action="Details"
                                   asp-route-id="@job.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View Job
                                </a>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>