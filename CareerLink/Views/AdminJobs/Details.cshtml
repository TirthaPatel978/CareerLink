@model CareerLink.ViewModels.AdminJobDetailsViewModel

@{
    ViewData["Title"] = "Job Details";
}

<div class="cl-admin-page">

    <div class="cl-admin-page-header">

        <div>
            <div class="cl-admin-eyebrow">
                <i class="bi bi-briefcase"></i>
                JOB DETAILS
            </div>

            <h1 class="cl-admin-title">
                @Model.Title
            </h1>

            <p class="cl-admin-subtitle">
                Admin view of job details and platform activity.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="AdminJobs"
               asp-action="Index"
               class="cl-soft-button">
                <i class="bi bi-arrow-left"></i>
                Jobs
            </a>

            <a asp-controller="Admin"
               asp-action="Index"
               class="cl-soft-button">
                Dashboard
            </a>

        </div>

    </div>

    <div class="cl-admin-details-grid">

        <div>

            <div class="cl-admin-detail-card">

                <div class="cl-admin-detail-card-header">

                    <div class="cl-admin-detail-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <div>
                        <h2>Job Information</h2>
                        <p>Posting details and requirements.</p>
                    </div>

                </div>

                <div class="cl-admin-detail-list">

                    <div>
                        <span>Job Title</span>
                        <strong>@Model.Title</strong>
                    </div>

                    <div>
                        <span>Company</span>
                        <strong>@Model.CompanyName</strong>
                    </div>

                    <div>
                        <span>Job Type</span>
                        <strong>@Model.JobType</strong>
                    </div>

                    <div>
                        <span>Location</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Location)
                                ? "Not provided"
                                : Model.Location)
                        </strong>
                    </div>

                    <div>
                        <span>Remote</span>
                        <strong>
                            @(Model.IsRemote ? "Yes" : "No")
                        </strong>
                    </div>

                    <div>
                        <span>Salary</span>
                        <strong>
                            @if (Model.SalaryMin.HasValue && Model.SalaryMax.HasValue)
                            {
                                @($"{Model.SalaryMin.Value:N2} - {Model.SalaryMax.Value:N2}")
                            }
                            else if (Model.SalaryMin.HasValue)
                            {
                                @($"From {Model.SalaryMin.Value:N2}")
                            }
                            else if (Model.SalaryMax.HasValue)
                            {
                                @($"Up to {Model.SalaryMax.Value:N2}")
                            }
                            else
                            {
                                <span>Not provided</span>
                            }
                        </strong>
                    </div>

                    <div>
                        <span>Experience Required</span>
                        <strong>
                            @Model.ExperienceRequired years
                        </strong>
                    </div>

                    <div>
                        <span>Education</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.EducationRequirement)
                                ? "Not specified"
                                : Model.EducationRequirement)
                        </strong>
                    </div>

                    <div>
                        <span>Application Deadline</span>
                        <strong>
                            @if (Model.ApplicationDeadline.HasValue)
                            {
                                var deadline = Model.ApplicationDeadline.Value.ToLocalTime();
                                @deadline.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span>No deadline</span>
                            }
                        </strong>
                    </div>

                    <div>
                        <span>Created</span>
                        <strong>
                            @{
                                var createdAt = Model.CreatedAt.ToLocalTime();
                            }
                            @createdAt.ToString("dd MMM yyyy, hh:mm tt")
                        </strong>
                    </div>

                    <div>
                        <span>Last Updated</span>
                        <strong>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                var updatedAt = Model.UpdatedAt.Value.ToLocalTime();
                                @updatedAt.ToString("dd MMM yyyy, hh:mm tt")
                            }
                            else
                            {
                                <span>Not updated</span>
                            }
                        </strong>
                    </div>

                </div>

            </div>

            <div class="cl-admin-detail-card mt-4">

                <div class="cl-admin-detail-card-header">

                    <div class="cl-admin-detail-icon">
                        <i class="bi bi-file-text"></i>
                    </div>

                    <div>
                        <h2>Description</h2>
                        <p>Job posting description.</p>
                    </div>

                </div>

                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="cl-admin-empty-content">
                        No job description has been provided.
                    </p>
                }
                else
                {
                    <p class="cl-admin-description">
                        @Model.Description
                    </p>
                }

            </div>

        </div>

        <div>

            <div class="cl-admin-detail-card">

                <div class="cl-admin-detail-card-header">

                    <div class="cl-admin-detail-icon">
                        <i class="bi bi-toggle-on"></i>
                    </div>

                    <div>
                        <h2>Job Status</h2>
                        <p>Control job availability.</p>
                    </div>

                </div>

                <div class="cl-admin-job-status-panel">

                    @if (Model.IsActive)
                    {
                        <span class="cl-admin-large-status cl-job-status-active">
                            <span></span>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="cl-admin-large-status cl-job-status-closed">
                            <span></span>
                            Closed
                        </span>
                    }

                    <form asp-controller="AdminJobs"
                          asp-action="ToggleStatus"
                          asp-route-id="@Model.Id"
                          method="post">

                        @if (Model.IsActive)
                        {
                            <button type="submit"
                                    class="cl-admin-danger-button w-100">
                                <i class="bi bi-x-circle"></i>
                                Close Job
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="cl-admin-success-button w-100">
                                <i class="bi bi-check-circle"></i>
                                Activate Job
                            </button>
                        }

                    </form>

                </div>

            </div>

            <div class="cl-admin-detail-card mt-4">

                <div class="cl-admin-detail-card-header">

                    <div class="cl-admin-detail-icon">
                        <i class="bi bi-bar-chart"></i>
                    </div>

                    <div>
                        <h2>Platform Activity</h2>
                        <p>Application activity.</p>
                    </div>

                </div>

                <div class="cl-admin-big-number">
                    @Model.ApplicationCount
                </div>

                <div class="cl-admin-big-number-label">
                    Total Applications
                </div>

            </div>

        </div>

    </div>

</div>