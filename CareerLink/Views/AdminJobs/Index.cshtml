@model IEnumerable<CareerLink.ViewModels.AdminJobListViewModel>

@{
    ViewData["Title"] = "Manage Jobs";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Manage Jobs</h1>
            <p class="text-muted mb-0">
                View and manage jobs posted on the CareerLink platform.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Job</th>
                            <th>Company</th>
                            <th>Type</th>
                            <th>Location</th>
                            <th>Applications</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var job in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@job.Title</strong>

                                    @if (job.IsRemote)
                                    {
                                        <div>
                                            <small class="text-muted">
                                                Remote
                                            </small>
                                        </div>
                                    }
                                </td>

                                <td>
                                    @job.CompanyName
                                </td>

                                <td>
                                    @job.JobType
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(job.Location)
                                        ? "—"
                                        : job.Location)
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @job.ApplicationCount
                                    </span>
                                </td>

                                <td>
                                    @if (job.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Closed
                                        </span>
                                    }
                                </td>

                                <td>
                                    @job.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </td>

                                <td class="text-end">

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-controller="AdminJobs"
                                           asp-action="Details"
                                           asp-route-id="@job.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>

                                        <form asp-controller="AdminJobs"
                                              asp-action="ToggleStatus"
                                              asp-route-id="@job.Id"
                                              method="post">

                                            @if (job.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Close
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Activate
                                                </button>
                                            }

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>No jobs found.</h5>
                    <p class="text-muted mb-0">
                        There are currently no jobs posted on CareerLink.
                    </p>
                </div>
            }

        </div>

    </div>

</div>