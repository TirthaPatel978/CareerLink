@model IEnumerable<CareerLink.ViewModels.AdminJobListViewModel>

@{
    ViewData["Title"] = "Manage Jobs";
}

<div class="cl-admin-page">

    <div class="cl-admin-page-header">

        <div>
            <div class="cl-admin-eyebrow">
                <i class="bi bi-briefcase"></i>
                JOB MANAGEMENT
            </div>

            <h1 class="cl-admin-title">
                Manage Jobs
            </h1>

            <p class="cl-admin-subtitle">
                View and manage jobs posted on the CareerLink platform.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="cl-soft-button">
            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cl-profile-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="cl-admin-table-card">

        <div class="cl-admin-table-header">
            <div>
                <h2>Job Postings</h2>
                <p>@Model.Count() job@(Model.Count() == 1 ? "" : "s") listed.</p>
            </div>

            <div class="cl-admin-table-count">
                <i class="bi bi-briefcase"></i>
                @Model.Count()
            </div>
        </div>

        <div class="table-responsive">

            <table class="table cl-admin-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Job</th>
                        <th>Company</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Applications</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var job in Model)
                    {
                        <tr>

                            <td>
                                <div class="cl-admin-job-cell">
                                    <div class="cl-admin-job-icon">
                                        <i class="bi bi-briefcase"></i>
                                    </div>

                                    <div>
                                        <strong>@job.Title</strong>

                                        @if (job.IsRemote)
                                        {
                                            <span class="cl-admin-remote">
                                                <i class="bi bi-globe2"></i>
                                                Remote
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>
                                @job.CompanyName
                            </td>

                            <td>
                                <span class="cl-admin-type-badge">
                                    @job.JobType
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(job.Location)
                                    ? "—"
                                    : job.Location)
                            </td>

                            <td>
                                <span class="cl-admin-number-badge">
                                    @job.ApplicationCount
                                </span>
                            </td>

                            <td>

                                @if (job.IsActive)
                                {
                                    <span class="cl-admin-account-status cl-account-active">
                                        <span></span>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="cl-admin-account-status cl-account-inactive">
                                        <span></span>
                                        Closed
                                    </span>
                                }

                            </td>

                            <td>
                                @job.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </td>

                            <td class="text-end">

                                <div class="cl-admin-job-actions">

                                    <a asp-controller="AdminJobs"
                                       asp-action="Details"
                                       asp-route-id="@job.Id"
                                       class="cl-view-applicant-button">
                                        View
                                        <i class="bi bi-arrow-right"></i>
                                    </a>

                                    <form asp-controller="AdminJobs"
                                          asp-action="ToggleStatus"
                                          asp-route-id="@job.Id"
                                          method="post">

                                        @if (job.IsActive)
                                        {
                                            <button type="submit"
                                                    class="cl-admin-danger-button">
                                                Close
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="cl-admin-success-button">
                                                Activate
                                            </button>
                                        }

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @if (!Model.Any())
        {
            <div class="cl-admin-empty-state">
                <div>
                    <i class="bi bi-briefcase"></i>
                </div>
                <h3>No jobs found</h3>
                <p>There are currently no jobs posted on CareerLink.</p>
            </div>
        }

    </div>

</div>