@model CareerLink.ViewModels.CertificationViewModel

@{
    ViewData["Title"] = "Add Certification";
}

<div class="cl-certifications-page">

    <section class="cl-certifications-header">
        <div class="container">

            <div class="cl-certifications-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-award"></i>
                        Professional Profile
                    </div>

                    <h1>Add Certification</h1>

                    <p>
                        Add a professional certification to strengthen
                        your CareerLink profile.
                    </p>
                </div>

                <a asp-action="Index"
                   class="cl-certifications-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Certifications
                </a>

            </div>

        </div>
    </section>


    <section class="cl-certifications-form-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-8 col-xl-7">

                    <div class="cl-certifications-form-card">

                        <div class="cl-certifications-form-heading">

                            <div class="cl-certifications-form-icon">
                                <i class="bi bi-plus-lg"></i>
                            </div>

                            <div>

                                <div class="cl-small-label">
                                    NEW CERTIFICATION
                                </div>

                                <h2>Add a professional credential</h2>

                                <p>
                                    Enter the details of a certification
                                    you have earned.
                                </p>

                            </div>

                        </div>


                        <form asp-action="Create"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="cl-certifications-validation">
                            </div>


                            <div class="cl-certifications-field">

                                <label asp-for="Name"
                                       class="cl-certifications-label">
                                </label>

                                <input asp-for="Name"
                                       class="cl-certifications-input"
                                       placeholder="e.g. AWS Certified Cloud Practitioner" />

                                <div class="cl-certifications-help">
                                    <i class="bi bi-info-circle"></i>
                                    Enter the official name of your certification.
                                </div>

                                <span asp-validation-for="Name"
                                      class="cl-certifications-error">
                                </span>

                            </div>


                            <div class="cl-certifications-field">

                                <label asp-for="IssuingOrganization"
                                       class="cl-certifications-label">
                                </label>

                                <input asp-for="IssuingOrganization"
                                       class="cl-certifications-input"
                                       placeholder="e.g. Amazon Web Services" />

                                <div class="cl-certifications-help">
                                    <i class="bi bi-building"></i>
                                    Add the organization that issued the certification.
                                </div>

                                <span asp-validation-for="IssuingOrganization"
                                      class="cl-certifications-error">
                                </span>

                            </div>


                            <div class="row g-3">

                                <div class="col-md-6">

                                    <div class="cl-certifications-field">

                                        <label asp-for="IssueDate"
                                               class="cl-certifications-label">
                                        </label>

                                        <input asp-for="IssueDate"
                                               type="date"
                                               class="cl-certifications-input" />

                                        <span asp-validation-for="IssueDate"
                                              class="cl-certifications-error">
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="cl-certifications-field">

                                        <label asp-for="ExpiryDate"
                                               class="cl-certifications-label">
                                        </label>

                                        <input asp-for="ExpiryDate"
                                               type="date"
                                               class="cl-certifications-input" />

                                        <div class="cl-certifications-help">
                                            <i class="bi bi-calendar-check"></i>
                                            Leave blank if the certification does not expire.
                                        </div>

                                        <span asp-validation-for="ExpiryDate"
                                              class="cl-certifications-error">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="cl-certifications-field">

                                <label asp-for="CredentialUrl"
                                       class="cl-certifications-label">
                                </label>

                                <input asp-for="CredentialUrl"
                                       class="cl-certifications-input"
                                       placeholder="https://..." />

                                <div class="cl-certifications-help">
                                    <i class="bi bi-link-45deg"></i>
                                    Optional link to verify your certification.
                                </div>

                                <span asp-validation-for="CredentialUrl"
                                      class="cl-certifications-error">
                                </span>

                            </div>


                            <div class="cl-certifications-form-footer">

                                <a asp-action="Index"
                                   class="cl-certifications-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-certifications-save-btn">

                                    <i class="bi bi-plus-lg"></i>
                                    Add Certification

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}