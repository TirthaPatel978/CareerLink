@model IEnumerable<CareerLink.ViewModels.CertificationViewModel>

@{
    ViewData["Title"] = "Certifications";
}

<div class="cl-certifications-page">

    <section class="cl-certifications-header">
        <div class="container">
            <div class="cl-certifications-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-award"></i>
                        Professional Profile
                    </div>

                    <h1>Certifications</h1>

                    <p>
                        Showcase professional certifications that
                        strengthen your CareerLink profile.
                    </p>
                </div>

                <a asp-action="Create"
                   class="cl-certifications-add-btn">
                    <i class="bi bi-plus-lg"></i>
                    Add Certification
                </a>

            </div>
        </div>
    </section>


    <section class="cl-certifications-main">
        <div class="container">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="cl-certifications-success">

                    <div class="cl-certifications-success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <div>
                        <strong>Certification updated</strong>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>

                    <button type="button"
                            class="btn-close ms-auto"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            @if (!Model.Any())
            {
                <div class="cl-certifications-empty">

                    <div class="cl-certifications-empty-icon">
                        <i class="bi bi-award"></i>
                    </div>

                    <div class="cl-certifications-empty-label">
                        PROFESSIONAL CREDENTIALS
                    </div>

                    <h2>No certifications added yet</h2>

                    <p>
                        Add professional certifications to give employers
                        a clearer picture of your qualifications and expertise.
                    </p>

                    <a asp-action="Create"
                       class="cl-certifications-primary-btn">
                        <i class="bi bi-plus-lg"></i>
                        Add Your First Certification
                    </a>

                </div>
            }
            else
            {
                <div class="cl-certifications-section-heading">

                    <div>
                        <div class="cl-small-label">
                            YOUR CERTIFICATIONS
                        </div>

                        <h2>Professional credentials</h2>

                        <p>
                            Keep your certifications and credentials
                            up to date.
                        </p>
                    </div>

                    <div class="cl-certifications-count">
                        <span>@Model.Count()</span>
                        <small>
                            @(Model.Count() == 1
                                ? "Certification"
                                : "Certifications")
                        </small>
                    </div>

                </div>


                <div class="row g-4">

                    @foreach (var item in Model)
                    {
                        <div class="col-md-6 col-xl-4">

                            <div class="cl-certification-card">

                                <div class="cl-certification-card-top">

                                    <div class="cl-certification-icon">
                                        <i class="bi bi-award"></i>
                                    </div>

                                    <div class="cl-certification-card-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="cl-certification-icon-btn"
                                           title="Edit certification">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="cl-certification-icon-btn cl-certification-delete-btn"
                                           title="Delete certification">
                                            <i class="bi bi-trash3"></i>
                                        </a>

                                    </div>

                                </div>


                                <div class="cl-certification-card-content">

                                    <div class="cl-certification-label">
                                        CERTIFICATION
                                    </div>

                                    <h3>
                                        @item.Name
                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.IssuingOrganization))
                                    {
                                        <div class="cl-certification-issuer">

                                            <i class="bi bi-building"></i>

                                            <span>
                                                @item.IssuingOrganization
                                            </span>

                                        </div>
                                    }


                                    <div class="cl-certification-details">

                                        <div class="cl-certification-detail">

                                            <span>Issued</span>

                                            <strong>
                                                @item.IssueDate.ToString("dd MMM yyyy")
                                            </strong>

                                        </div>


                                        <div class="cl-certification-detail">

                                            <span>Expiry</span>

                                            <strong class="@(item.ExpiryDate.HasValue
                                                                                                ? ""
                                                                                                : "cl-certification-no-expiry")">

                                                @(item.ExpiryDate.HasValue
                                                    ? item.ExpiryDate.Value.ToString("dd MMM yyyy")
                                                    : "No expiry")

                                            </strong>

                                        </div>

                                    </div>

                                </div>


                                <div class="cl-certification-card-footer">

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.CredentialUrl))
                                    {
                                        <a href="@item.CredentialUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="cl-certification-credential-btn">

                                            <i class="bi bi-box-arrow-up-right"></i>
                                            View Credential

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="cl-certification-no-credential">
                                            <i class="bi bi-link-45deg"></i>
                                            No credential link
                                        </span>
                                    }

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="cl-certification-edit-link">

                                        Edit
                                        <i class="bi bi-arrow-right"></i>

                                    </a>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>
    </section>

</div>