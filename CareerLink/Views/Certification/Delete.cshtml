@model CareerLink.ViewModels.CertificationViewModel

@{
    ViewData["Title"] = "Delete Certification";
}

<div class="cl-certifications-page">

    <section class="cl-certifications-header">

        <div class="container">

            <div class="cl-certifications-header-content">

                <div>

                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-award"></i>
                        Professional Profile
                    </div>

                    <h1>Delete Certification</h1>

                    <p>
                        Review this certification before removing it
                        from your profile.
                    </p>

                </div>

                <a asp-action="Index"
                   class="cl-certifications-back-btn">

                    <i class="bi bi-arrow-left"></i>
                    Back to Certifications

                </a>

            </div>

        </div>

    </section>


    <section class="cl-certifications-form-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-7 col-xl-6">

                    <div class="cl-certifications-delete-card">

                        <div class="cl-certifications-delete-icon">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <div class="cl-small-label">
                            REMOVE CERTIFICATION
                        </div>

                        <h2>Are you sure?</h2>

                        <p class="cl-certifications-delete-description">
                            This will permanently remove this certification
                            from your professional profile.
                        </p>


                        <div class="cl-certifications-delete-details">

                            <div class="cl-certifications-delete-detail">

                                <span>Certification</span>

                                <strong>
                                    @Model.Name
                                </strong>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                Model.IssuingOrganization))
                            {
                                <div class="cl-certifications-delete-detail">

                                    <span>Issued By</span>

                                    <strong>
                                        @Model.IssuingOrganization
                                    </strong>

                                </div>
                            }


                            <div class="cl-certifications-delete-detail">

                                <span>Issue Date</span>

                                <strong>
                                    @Model.IssueDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <div class="cl-certifications-delete-detail">

                                <span>Expiry</span>

                                <strong>

                                    @(Model.ExpiryDate.HasValue
                                        ? Model.ExpiryDate.Value.ToString("dd MMM yyyy")
                                        : "No expiry")

                                </strong>

                            </div>

                        </div>


                        <form asp-action="DeleteConfirmed"
                              method="post">

                            <input type="hidden"
                                   asp-for="Id" />


                            <div class="cl-certifications-delete-footer">

                                <a asp-action="Index"
                                   class="cl-certifications-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-certifications-delete-confirm-btn">

                                    <i class="bi bi-trash3"></i>
                                    Delete Certification

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>