@model CareerLink.ViewModels.RecruiterApplicantDetailsViewModel

@{
    ViewData["Title"] = "Applicant Details";

    var badgeClass =
        Model.Status switch
        {
            CareerLink.Models.Enums.ApplicationStatus.Applied
                => "cl-status-applied",

            CareerLink.Models.Enums.ApplicationStatus.UnderReview
                => "cl-status-review",

            CareerLink.Models.Enums.ApplicationStatus.Shortlisted
                => "cl-status-shortlisted",

            CareerLink.Models.Enums.ApplicationStatus.Interview
                => "cl-status-interview",

            CareerLink.Models.Enums.ApplicationStatus.Selected
                => "cl-status-selected",

            CareerLink.Models.Enums.ApplicationStatus.Rejected
                => "cl-status-rejected",

            CareerLink.Models.Enums.ApplicationStatus.Withdrawn
                => "cl-status-withdrawn",

            _ => "cl-status-applied"
        };

    var statusText =
        Model.Status switch
        {
            CareerLink.Models.Enums.ApplicationStatus.UnderReview
                => "Under Review",

            _ => Model.Status.ToString()
        };
}

<div class="cl-recruiter-page">

    <div class="cl-profile-page-header">

        <div>
            <div class="cl-recruiter-eyebrow">
                <i class="bi bi-person-vcard"></i>
                CANDIDATE REVIEW
            </div>

            <h1 class="cl-profile-page-title">
                Applicant Details
            </h1>

            <p class="cl-profile-page-subtitle">
                Application for <strong>@Model.JobTitle</strong>
            </p>
        </div>

        <a asp-controller="RecruiterApplications"
           asp-action="Index"
           asp-route-jobId="@Model.JobId"
           class="cl-soft-button">
            <i class="bi bi-arrow-left"></i>
            Back to Applicants
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cl-profile-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="cl-applicant-details-grid">

        <div>

            <!-- Applicant profile -->
            <div class="cl-profile-card cl-applicant-profile-card">

                <div class="cl-applicant-profile-header">

                    <div class="cl-applicant-large-avatar">
                        @(
                            string.IsNullOrWhiteSpace(Model.ApplicantName)
                                ? "?"
                                : Model.ApplicantName.Substring(0, 1).ToUpper()
                         )
                    </div>

                    <div>

                        <h2>
                            @Model.ApplicantName
                        </h2>

                        @if (!string.IsNullOrWhiteSpace(Model.ProfessionalTitle))
                        {
                            <p>
                                @Model.ProfessionalTitle
                            </p>
                        }

                        <span class="cl-status-badge @badgeClass">
                            <span></span>
                            @statusText
                        </span>

                    </div>

                </div>

                <div class="cl-applicant-contact-grid">

                    <div class="cl-applicant-contact-item">
                        <i class="bi bi-envelope"></i>

                        <div>
                            <span>Email</span>
                            <strong>@Model.ApplicantEmail</strong>
                        </div>
                    </div>

                    <div class="cl-applicant-contact-item">
                        <i class="bi bi-telephone"></i>

                        <div>
                            <span>Phone</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.ApplicantPhone)
                                    ? "Not provided"
                                    : Model.ApplicantPhone)
                            </strong>
                        </div>
                    </div>

                    <div class="cl-applicant-contact-item">
                        <i class="bi bi-geo-alt"></i>

                        <div>
                            <span>Location</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Location)
                                    ? "Not provided"
                                    : Model.Location)
                            </strong>
                        </div>
                    </div>

                    <div class="cl-applicant-contact-item">
                        <i class="bi bi-building"></i>

                        <div>
                            <span>Company</span>
                            <strong>@Model.CompanyName</strong>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Professional summary -->
            <div class="cl-profile-card cl-applicant-content-card">

                <div class="cl-applicant-section-heading">
                    <div class="cl-applicant-section-icon">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>

                    <div>
                        <h3>Professional Summary</h3>
                        <p>Candidate profile overview</p>
                    </div>
                </div>

                @if (string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <p class="cl-applicant-empty-content">
                        No professional summary provided.
                    </p>
                }
                else
                {
                    <p class="cl-applicant-content-text">
                        @Model.Summary
                    </p>
                }

            </div>

            <!-- Cover letter -->
            <div class="cl-profile-card cl-applicant-content-card">

                <div class="cl-applicant-section-heading">
                    <div class="cl-applicant-section-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>
                        <h3>Cover Letter</h3>
                        <p>Candidate's application message</p>
                    </div>
                </div>

                @if (string.IsNullOrWhiteSpace(Model.CoverLetter))
                {
                    <p class="cl-applicant-empty-content">
                        No cover letter provided.
                    </p>
                }
                else
                {
                    <p class="cl-applicant-content-text">
                        @Model.CoverLetter
                    </p>
                }

            </div>

            <!-- Resume -->
            <div class="cl-profile-card cl-applicant-content-card">

                <div class="cl-applicant-section-heading">
                    <div class="cl-applicant-section-icon">
                        <i class="bi bi-file-earmark-pdf"></i>
                    </div>

                    <div>
                        <h3>Resume</h3>
                        <p>Resume submitted with this application</p>
                    </div>
                </div>

                @if (string.IsNullOrWhiteSpace(Model.ResumePath))
                {
                    <p class="cl-applicant-empty-content">
                        No resume was uploaded with this application.
                    </p>
                }
                else
                {
                    <div class="cl-resume-box">
                        <i class="bi bi-file-earmark-pdf"></i>

                        <div>
                            <span>Resume</span>
                            <strong>@Model.ResumePath</strong>
                        </div>
                    </div>
                }

            </div>

        </div>

        <!-- Application management -->
        <div class="cl-applicant-sidebar">

            <!-- Application overview -->
            <div class="cl-profile-card cl-applicant-sidebar-card">

                <div class="cl-sidebar-heading">
                    <i class="bi bi-clipboard-check"></i>
                    <h3>Application</h3>
                </div>

                <div class="cl-application-stat">

                    <span>Current Status</span>

                    <span class="cl-status-badge @badgeClass">
                        <span></span>
                        @statusText
                    </span>

                </div>

                <div class="cl-application-stat">

                    <span>Match Score</span>

                    @if (Model.MatchScore.HasValue)
                    {
                        <strong class="cl-detail-match-score">
                            @Model.MatchScore.Value.ToString("0.##")%
                        </strong>
                    }
                    else
                    {
                        <span class="text-muted">
                            Not calculated
                        </span>
                    }

                </div>

                <div class="cl-application-stat">

                    <span>Applied</span>

                    <strong>
                        @Model.AppliedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                    </strong>

                </div>

                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="cl-application-stat">

                        <span>Last Updated</span>

                        <strong>
                            @Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </strong>

                    </div>
                }

            </div>

            <!-- Interview -->
            <div class="cl-profile-card cl-applicant-sidebar-card">

                <div class="cl-sidebar-heading">
                    <i class="bi bi-calendar2-event"></i>
                    <h3>Interview</h3>
                </div>

                @if (Model.Status == CareerLink.Models.Enums.ApplicationStatus.Shortlisted ||
                     Model.Status == CareerLink.Models.Enums.ApplicationStatus.Interview)
                {
                    <p class="cl-sidebar-description">
                        Schedule an interview for this applicant.
                    </p>

                    <a asp-controller="RecruiterInterviews"
                       asp-action="Create"
                       asp-route-applicationId="@Model.ApplicationId"
                       class="cl-purple-button w-100 justify-content-center">
                        <i class="bi bi-calendar-plus"></i>
                        Schedule Interview
                    </a>
                }
                else
                {
                    <div class="cl-interview-locked">
                        <i class="bi bi-lock"></i>

                        <p>
                            Shortlist the applicant before scheduling
                            an interview.
                        </p>
                    </div>
                }

                <a asp-controller="RecruiterInterviews"
                   asp-action="Index"
                   class="cl-soft-button w-100 justify-content-center mt-2">
                    <i class="bi bi-calendar3"></i>
                    View Interviews
                </a>

            </div>

            <!-- Status management -->
            <div class="cl-profile-card cl-applicant-sidebar-card">

                <div class="cl-sidebar-heading">
                    <i class="bi bi-arrow-repeat"></i>
                    <h3>Update Status</h3>
                </div>

                <form asp-controller="RecruiterApplications"
                      asp-action="UpdateStatus"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.ApplicationId" />

                    <div class="mb-3">

                        <label for="status"
                               class="form-label">
                            Application Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            <option value="Applied"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Applied)">
                                Applied
                            </option>

                            <option value="UnderReview"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.UnderReview)">
                                Under Review
                            </option>

                            <option value="Shortlisted"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Shortlisted)">
                                Shortlisted
                            </option>

                            <option value="Interview"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Interview)">
                                Interview
                            </option>

                            <option value="Selected"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Selected)">
                                Selected
                            </option>

                            <option value="Rejected"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Rejected)">
                                Rejected
                            </option>

                        </select>

                    </div>

                    <button type="submit"
                            class="cl-purple-button w-100 justify-content-center">
                        <i class="bi bi-check-circle"></i>
                        Update Status
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>