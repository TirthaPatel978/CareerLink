@model CareerLink.ViewModels.RecruiterApplicantDetailsViewModel

@{
    ViewData["Title"] = "Applicant Details";

    var badgeClass =
        Model.Status switch
        {
            CareerLink.Models.Enums.ApplicationStatus.Applied
                => "bg-secondary",

            CareerLink.Models.Enums.ApplicationStatus.UnderReview
                => "bg-info text-dark",

            CareerLink.Models.Enums.ApplicationStatus.Shortlisted
                => "bg-success",

            CareerLink.Models.Enums.ApplicationStatus.Interview
                => "bg-primary",

            CareerLink.Models.Enums.ApplicationStatus.Selected
                => "bg-success",

            CareerLink.Models.Enums.ApplicationStatus.Rejected
                => "bg-danger",

            CareerLink.Models.Enums.ApplicationStatus.Withdrawn
                => "bg-dark",

            _ => "bg-secondary"
        };

    var statusText =
        Model.Status switch
        {
            CareerLink.Models.Enums.ApplicationStatus.UnderReview
                => "Under Review",

            _ => Model.Status.ToString()
        };
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Applicant Details</h1>

            <p class="text-muted mb-0">
                Application for <strong>@Model.JobTitle</strong>
            </p>
        </div>

        <a asp-controller="RecruiterApplications"
           asp-action="Index"
           asp-route-jobId="@Model.JobId"
           class="btn btn-outline-secondary">
            Back to Applicants
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">

        <!-- Applicant information -->
        <div class="col-lg-8">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h3 class="mb-1">
                        @Model.ApplicantName
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(Model.ProfessionalTitle))
                    {
                        <p class="text-muted mb-3">
                            @Model.ProfessionalTitle
                        </p>
                    }

                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Email
                            </div>

                            <div>
                                @Model.ApplicantEmail
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Phone
                            </div>

                            <div>
                                @(string.IsNullOrWhiteSpace(Model.ApplicantPhone)
                                    ? "Not provided"
                                    : Model.ApplicantPhone)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Location
                            </div>

                            <div>
                                @(string.IsNullOrWhiteSpace(Model.Location)
                                    ? "Not provided"
                                    : Model.Location)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">
                                Company
                            </div>

                            <div>
                                @Model.CompanyName
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Professional summary -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4>Professional Summary</h4>

                    @if (string.IsNullOrWhiteSpace(Model.Summary))
                    {
                        <p class="text-muted mb-0">
                            No professional summary provided.
                        </p>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space: pre-line;">
                            @Model.Summary
                        </p>
                    }

                </div>
            </div>

            <!-- Cover letter -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4>Cover Letter</h4>

                    @if (string.IsNullOrWhiteSpace(Model.CoverLetter))
                    {
                        <p class="text-muted mb-0">
                            No cover letter provided.
                        </p>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space: pre-line;">
                            @Model.CoverLetter
                        </p>
                    }

                </div>
            </div>

            <!-- Resume -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4>Resume</h4>

                    @if (string.IsNullOrWhiteSpace(Model.ResumePath))
                    {
                        <p class="text-muted mb-0">
                            No resume was uploaded with this application.
                        </p>
                    }
                    else
                    {
                        <p class="mb-0">
                            Resume:
                            <strong>@Model.ResumePath</strong>
                        </p>
                    }

                </div>
            </div>

        </div>

        <!-- Application management -->
        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="mb-3">
                        Application
                    </h4>

                    <div class="mb-3">
                        <div class="text-muted small">
                            Current Status
                        </div>

                        <span class="badge @badgeClass">
                            @statusText
                        </span>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small">
                            Match Score
                        </div>

                        @if (Model.MatchScore.HasValue)
                        {
                            <div class="fs-4 fw-semibold">
                                @Model.MatchScore.Value.ToString("0.##")%
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                Not calculated
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small">
                            Applied
                        </div>

                        <div>
                            @Model.AppliedAt
                                .ToLocalTime()
                                .ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="mb-3">
                            <div class="text-muted small">
                                Last Updated
                            </div>

                            <div>
                                @Model.UpdatedAt.Value
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    }

                </div>
            </div>

            <!-- Schedule interview -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="mb-3">
                        Interview
                    </h4>

                    @if (Model.Status == CareerLink.Models.Enums.ApplicationStatus.Shortlisted ||
                         Model.Status == CareerLink.Models.Enums.ApplicationStatus.Interview)
                    {
                        <p class="text-muted">
                            Schedule an interview for this applicant.
                        </p>

                        <a asp-controller="RecruiterInterviews"
                           asp-action="Create"
                           asp-route-applicationId="@Model.ApplicationId"
                           class="btn btn-primary w-100">
                            Schedule Interview
                        </a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Shortlist the applicant before scheduling an interview.
                        </p>
                    }

                    <a asp-controller="RecruiterInterviews"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100 mt-2">
                        View Interviews
                    </a>

                </div>
            </div>

            <!-- Status management -->
            <div class="card shadow-sm">
                <div class="card-body">

                    <h4 class="mb-3">
                        Update Status
                    </h4>

                    <form asp-controller="RecruiterApplications"
                          asp-action="UpdateStatus"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.ApplicationId" />

                        <div class="mb-3">
                            <label for="status"
                                   class="form-label">
                                Application Status
                            </label>

                            <select id="status"
                                    name="status"
                                    class="form-select">

                                <option value="Applied"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Applied)">
                                    Applied
                                </option>

                                <option value="UnderReview"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.UnderReview)">
                                    Under Review
                                </option>

                                <option value="Shortlisted"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Shortlisted)">
                                    Shortlisted
                                </option>

                                <option value="Interview"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Interview)">
                                    Interview
                                </option>

                                <option value="Selected"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Selected)">
                                    Selected
                                </option>

                                <option value="Rejected"
                                    selected="@(Model.Status == CareerLink.Models.Enums.ApplicationStatus.Rejected)">
                                    Rejected
                                </option>

                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Update Status
                        </button>

                    </form>

                </div>
            </div>

        </div>

    </div>
</div>