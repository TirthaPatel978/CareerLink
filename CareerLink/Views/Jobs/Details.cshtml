@model CareerLink.ViewModels.JobDetailsViewModel

@using CareerLink.Models.Enums

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">

    <!-- Back -->
    <div class="mb-4">

        <a asp-action="Index"
           class="back-link">

            <i class="bi bi-arrow-left me-1"></i>

            Back to jobs

        </a>

    </div>


    <!-- Job Header -->
    <div class="career-card mb-4">

        <div class="career-card-body">

            <div class="row align-items-start">

                <div class="col-lg-8">

                    <span class="section-eyebrow">
                        JOB OPPORTUNITY
                    </span>


                    <h1 class="display-6 fw-bold mt-2 mb-2">
                        @Model.Title
                    </h1>


                    <p class="job-company-large mb-4">

                        <i class="bi bi-building me-1"></i>

                        @Model.CompanyName

                    </p>


                    <div class="d-flex flex-wrap gap-2">

                        <span class="badge job-type-badge">
                            @Model.JobType
                        </span>


                        @if (Model.IsRemote)
                        {
                            <span class="badge remote-badge">

                                <i class="bi bi-globe2 me-1"></i>

                                Remote

                            </span>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Location))
                        {
                            <span class="badge location-badge">

                                <i class="bi bi-geo-alt me-1"></i>

                                @Model.Location

                            </span>
                        }

                    </div>

                </div>


                <!-- Actions -->
                <div class="col-lg-4 mt-4 mt-lg-0">

                    <div class="d-flex flex-column gap-2">

                        @if (Model.IsSaved)
                        {
                            <form asp-controller="SavedJobs"
                                  asp-action="Remove"
                                  method="post">

                                <input type="hidden"
                                       name="jobId"
                                       value="@Model.Id" />

                                <button type="submit"
                                        class="btn btn-outline-primary w-100">

                                    <i class="bi bi-bookmark-fill me-1"></i>

                                    Remove Saved Job

                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-controller="SavedJobs"
                                  asp-action="Save"
                                  method="post">

                                <input type="hidden"
                                       name="jobId"
                                       value="@Model.Id" />

                                <button type="submit"
                                        class="btn btn-outline-primary w-100">

                                    <i class="bi bi-bookmark me-1"></i>

                                    Save Job

                                </button>

                            </form>
                        }


                        <a asp-action="Match"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary w-100">

                            <i class="bi bi-stars me-1"></i>

                            Check My Match

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- Main Content -->
        <div class="col-lg-8">


            <!-- Job Description -->
            <div class="career-card mb-4">

                <div class="career-card-body">

                    <span class="section-eyebrow">
                        ABOUT THE ROLE
                    </span>

                    <h2 class="h4 fw-bold mt-2 mb-4">
                        Job Description
                    </h2>


                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="job-description">

                            @Model.Description

                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No job description has been provided.
                        </p>
                    }

                </div>

            </div>


            <!-- Job Requirements -->
            <div class="career-card mb-4">

                <div class="career-card-body">

                    <span class="section-eyebrow">
                        REQUIREMENTS
                    </span>

                    <h2 class="h4 fw-bold mt-2 mb-4">
                        What we're looking for
                    </h2>


                    <div class="row g-4">

                        <!-- Experience -->
                        <div class="col-md-6">

                            <div class="requirement-card">

                                <div class="requirement-icon">

                                    <i class="bi bi-briefcase"></i>

                                </div>

                                <div>

                                    <h3 class="h6 fw-bold mb-1">
                                        Experience
                                    </h3>

                                    @if (Model.ExperienceRequired > 0)
                                    {
                                        <p class="text-muted mb-0">

                                            @Model.ExperienceRequired.ToString("0.0")
                                            years required

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">
                                            No specific experience required.
                                        </p>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- Education -->
                        <div class="col-md-6">

                            <div class="requirement-card">

                                <div class="requirement-icon">

                                    <i class="bi bi-mortarboard"></i>

                                </div>

                                <div>

                                    <h3 class="h6 fw-bold mb-1">
                                        Education
                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(Model.EducationRequirement))
                                    {
                                        <p class="text-muted mb-0">
                                            @Model.EducationRequirement
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">
                                            No specific education requirement.
                                        </p>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Skills -->
            <div class="career-card mb-4">

                <div class="career-card-body">

                    <span class="section-eyebrow">
                        SKILLS
                    </span>

                    <h2 class="h4 fw-bold mt-2 mb-4">
                        Required skills
                    </h2>


                    @if (Model.Skills != null &&
                        Model.Skills.Any())
                    {
                        <div class="row g-3">

                            @foreach (var skill in Model.Skills)
                            {
                                <div class="col-md-6">

                                    <div class="skill-requirement">

                                        <div>

                                            <span class="fw-semibold">
                                                @skill.Name
                                            </span>

                                            @if (skill.IsRequired)
                                            {
                                                <span class="badge required-badge ms-2">
                                                    Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge optional-badge ms-2">
                                                    Preferred
                                                </span>
                                            }

                                        </div>


                                        <span class="text-muted small">

                                            Weight:
                                            @skill.Weight.ToString("0.##")

                                        </span>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No specific skills were listed for this job.
                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- Sidebar -->
        <div class="col-lg-4">


            <!-- Job Overview -->
            <div class="career-card mb-4">

                <div class="career-card-body">

                    <span class="section-eyebrow">
                        JOB OVERVIEW
                    </span>

                    <h2 class="h5 fw-bold mt-2 mb-4">
                        At a glance
                    </h2>


                    <div class="overview-list">


                        <!-- Job Type -->
                        <div class="overview-item">

                            <div class="overview-icon">

                                <i class="bi bi-clock"></i>

                            </div>

                            <div>

                                <span class="overview-label">
                                    Job Type
                                </span>

                                <strong>
                                    @Model.JobType
                                </strong>

                            </div>

                        </div>


                        <!-- Location -->
                        <div class="overview-item">

                            <div class="overview-icon">

                                <i class="bi bi-geo-alt"></i>

                            </div>

                            <div>

                                <span class="overview-label">
                                    Location
                                </span>

                                <strong>

                                    @if (Model.IsRemote)
                                    {
                                        <text>Remote</text>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(Model.Location))
                                    {
                                        @Model.Location
                                    }
                                    else
                                    {
                                        <text>Not specified</text>
                                    }

                                </strong>

                            </div>

                        </div>


                        <!-- Salary -->
                        @if (Model.SalaryMin.HasValue ||
                            Model.SalaryMax.HasValue)
                        {
                            <div class="overview-item">

                                <div class="overview-icon">

                                    <i class="bi bi-cash-stack"></i>

                                </div>

                                <div>

                                    <span class="overview-label">
                                        Salary
                                    </span>

                                    <strong>

                                        @if (Model.SalaryMin.HasValue)
                                        {
                                            @Model.SalaryMin.Value.ToString("N0")
                                        }

                                        @if (Model.SalaryMin.HasValue &&
                                            Model.SalaryMax.HasValue)
                                        {
                                            <span>
                                                -
                                            </span>
                                        }

                                        @if (Model.SalaryMax.HasValue)
                                        {
                                            @Model.SalaryMax.Value.ToString("N0")
                                        }

                                    </strong>

                                </div>

                            </div>
                        }


                        <!-- Deadline -->
                        @if (Model.ApplicationDeadline.HasValue)
                        {
                            <div class="overview-item">

                                <div class="overview-icon">

                                    <i class="bi bi-calendar-event"></i>

                                </div>

                                <div>

                                    <span class="overview-label">
                                        Application Deadline
                                    </span>

                                    <strong>
                                        @Model.ApplicationDeadline.Value.ToString("dd MMM yyyy")
                                    </strong>

                                </div>

                            </div>
                        }


                        <!-- Posted -->
                        <div class="overview-item">

                            <div class="overview-icon">

                                <i class="bi bi-calendar-plus"></i>

                            </div>

                            <div>

                                <span class="overview-label">
                                    Posted
                                </span>

                                <strong>
                                    @Model.CreatedAt.ToString("dd MMM yyyy")
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Company -->
            <div class="career-card">

                <div class="career-card-body">

                    <span class="section-eyebrow">
                        COMPANY
                    </span>

                    <h2 class="h5 fw-bold mt-2 mb-3">
                        @Model.CompanyName
                    </h2>


                    @if (!string.IsNullOrWhiteSpace(Model.CompanyDescription))
                    {
                        <p class="text-muted small">
                            @Model.CompanyDescription
                        </p>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.CompanyLocation))
                    {
                        <p class="small mb-2">

                            <i class="bi bi-geo-alt me-1"></i>

                            @Model.CompanyLocation

                        </p>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.CompanyWebsite))
                    {
                        <a href="@Model.CompanyWebsite"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="company-link">

                            <i class="bi bi-box-arrow-up-right me-1"></i>

                            Visit company website

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>