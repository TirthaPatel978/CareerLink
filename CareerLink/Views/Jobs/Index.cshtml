@model CareerLink.ViewModels.JobSearchViewModel

@using CareerLink.Models.Enums

@{
    ViewData["Title"] = "Find Jobs";
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            Find Jobs
        </h1>

        <p class="text-muted">
            Search and explore job opportunities.
        </p>

    </div>

    <!-- Search and Filters -->

    <div class="card shadow-sm mb-4">

        <div class="card-body p-4">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-lg-5">

                        <label asp-for="Search"
                               class="form-label">
                        </label>

                        <input asp-for="Search"
                               class="form-control"
                               placeholder="Job title, company, keyword..." />

                    </div>

                    <div class="col-lg-3">

                        <label asp-for="Location"
                               class="form-label">
                        </label>

                        <input asp-for="Location"
                               class="form-control"
                               placeholder="e.g. Ahmedabad" />

                    </div>

                    <div class="col-lg-2">

                        <label asp-for="JobType"
                               class="form-label">
                        </label>

                        <select asp-for="JobType"
                                class="form-select">

                            <option value="">
                                All Types
                            </option>

                            @foreach (var type in Enum.GetValues<JobType>())
                            {
                                <option value="@type">
                                    @type
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-2 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Search
                        </button>

                    </div>

                </div>

                <div class="form-check mt-3">

                    <input asp-for="RemoteOnly"
                           class="form-check-input" />

                    <label asp-for="RemoteOnly"
                           class="form-check-label">
                    </label>

                </div>

            </form>

        </div>

    </div>

    <!-- Results -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="mb-0">
            Available Jobs
        </h4>

        <span class="text-muted">
            @Model.Jobs.Count job(s) found
        </span>

    </div>

    @if (!Model.Jobs.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h5>
                    No jobs found
                </h5>

                <p class="text-muted mb-0">
                    Try changing your search or filters.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var job in Model.Jobs)
            {
                <div class="col-12">

                    <div class="card shadow-sm">

                        <div class="card-body p-4">

                            <div class="row">

                                <div class="col-md-8">

                                    <h4 class="fw-bold mb-1">
                                        @job.Title
                                    </h4>

                                    <h6 class="text-primary mb-3">
                                        @job.CompanyName
                                    </h6>

                                    <div class="d-flex flex-wrap gap-2 mb-3">

                                        <span class="badge bg-secondary">
                                            @job.JobType
                                        </span>

                                        @if (job.IsRemote)
                                        {
                                            <span class="badge bg-success">
                                                Remote
                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(
                                            job.Location))
                                        {
                                            <span class="badge bg-light text-dark">
                                                @job.Location
                                            </span>
                                        }

                                    </div>

                                    @if (job.SalaryMin.HasValue ||
                                        job.SalaryMax.HasValue)
                                    {
                                        <p class="mb-2">

                                            <strong>
                                                Salary:
                                            </strong>

                                            @if (job.SalaryMin.HasValue)
                                            {
                                                @job.SalaryMin.Value.ToString("N0")
                                            }

                                            @if (job.SalaryMin.HasValue &&
                                                job.SalaryMax.HasValue)
                                            {
                                                <span> - </span>
                                            }

                                            @if (job.SalaryMax.HasValue)
                                            {
                                                @job.SalaryMax.Value.ToString("N0")
                                            }

                                        </p>
                                    }

                                    @if (job.ApplicationDeadline.HasValue)
                                    {
                                        <p class="text-muted mb-0">

                                            Application deadline:

                                            @job.ApplicationDeadline.Value
                                            .ToString("dd MMM yyyy")

                                        </p>
                                    }

                                </div>

                                <div class="col-md-4
                                    d-flex
                                    align-items-center
                                    justify-content-md-end
                                    mt-3
                                    mt-md-0">

                                    <a asp-action="Details"
                                       asp-route-id="@job.Id"
                                       class="btn btn-primary">
                                        View Details
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>