@model CareerLink.ViewModels.JobMatchViewModel

@{
    ViewData["Title"] = "Job Match";
}

<div class="job-match-page">

    <div class="container py-5">

        <!-- ============================================= -->
        <!-- HEADER -->
        <!-- ============================================= -->

        <div class="match-header">

            <a asp-action="Details"
               asp-route-id="@Model.JobId"
               class="back-link">

                <i class="bi bi-arrow-left"></i>

                Back to job

            </a>


            <span class="section-eyebrow">
                CAREERLINK MATCH
            </span>

            <h1>
                Your match for
                <span class="text-gradient">
                    @Model.JobTitle
                </span>
            </h1>

            <p>
                @Model.CompanyName
            </p>

        </div>


        <!-- ============================================= -->
        <!-- SCORE -->
        <!-- ============================================= -->

        <div class="match-score-card">

            <div class="match-score-circle"
                 style="--score:@Model.TotalScore.ToString("0.##")">

                <div>

                    <strong>
                        @Model.TotalScore.ToString("0")
                    </strong>

                    <span>
                        %
                    </span>

                </div>

            </div>


            <div class="match-score-content">

                <span class="section-eyebrow">
                    OVERALL MATCH
                </span>

                <h2>

                    @if (Model.TotalScore >= 80)
                    {
                        <text>Strong match</text>
                    }
                    else if (Model.TotalScore >= 60)
                    {
                        <text>Good match</text>
                    }
                    else if (Model.TotalScore >= 40)
                    {
                        <text>Moderate match</text>
                    }
                    else
                    {
                        <text>Low match</text>
                    }

                </h2>

                <p>
                    This score is calculated using CareerLink's
                    rule-based matching system.
                </p>

            </div>

        </div>


        <!-- ============================================= -->
        <!-- BREAKDOWN -->
        <!-- ============================================= -->

        <div class="match-breakdown">

            <div class="match-section-header">

                <span class="section-eyebrow">
                    SCORE BREAKDOWN
                </span>

                <h2>
                    How your score was calculated
                </h2>

            </div>


            <!-- Skills -->

            <div class="match-factor-card">

                <div class="match-factor-icon">

                    <i class="bi bi-code-slash"></i>

                </div>


                <div class="match-factor-content">

                    <div class="match-factor-heading">

                        <div>

                            <h3>
                                Skills
                            </h3>

                            <p>
                                @Model.MatchedSkills
                                of
                                @Model.TotalJobSkills
                                required skills matched.
                            </p>

                        </div>

                        <strong>
                            @Model.SkillScore.ToString("0.0")
                            /
                            @Model.SkillWeight.ToString("0.0")
                        </strong>

                    </div>


                    <div class="match-progress">

                        @{
                            decimal skillPercentage = 0;

                            if (Model.SkillWeight > 0)
                            {
                                skillPercentage =
                                    (Model.SkillScore /
                                    Model.SkillWeight) * 100;
                            }
                        }

                        <div class="match-progress-bar"
                             style="width:@skillPercentage.ToString("0.##")%">
                        </div>

                    </div>

                </div>

            </div>


            <!-- Education -->

            <div class="match-factor-card">

                <div class="match-factor-icon">

                    <i class="bi bi-mortarboard"></i>

                </div>


                <div class="match-factor-content">

                    <div class="match-factor-heading">

                        <div>

                            <h3>
                                Education
                            </h3>

                            <p>
                                @Model.EducationExplanation
                            </p>

                        </div>

                        <strong>
                            @Model.EducationScore.ToString("0.0")
                            /
                            @Model.EducationWeight.ToString("0.0")
                        </strong>

                    </div>


                    <div class="match-progress">

                        @{
                            decimal educationPercentage = 0;

                            if (Model.EducationWeight > 0)
                            {
                                educationPercentage =
                                    (Model.EducationScore /
                                    Model.EducationWeight) * 100;
                            }
                        }

                        <div class="match-progress-bar"
                             style="width:@educationPercentage.ToString("0.##")%">
                        </div>

                    </div>

                </div>

            </div>


            <!-- Experience -->

            <div class="match-factor-card">

                <div class="match-factor-icon">

                    <i class="bi bi-briefcase"></i>

                </div>


                <div class="match-factor-content">

                    <div class="match-factor-heading">

                        <div>

                            <h3>
                                Experience
                            </h3>

                            <p>
                                @Model.ExperienceExplanation
                            </p>

                        </div>

                        <strong>
                            @Model.ExperienceScore.ToString("0.0")
                            /
                            @Model.ExperienceWeight.ToString("0.0")
                        </strong>

                    </div>


                    <div class="match-progress">

                        @{
                            decimal experiencePercentage = 0;

                            if (Model.ExperienceWeight > 0)
                            {
                                experiencePercentage =
                                    (Model.ExperienceScore /
                                    Model.ExperienceWeight) * 100;
                            }
                        }

                        <div class="match-progress-bar"
                             style="width:@experiencePercentage.ToString("0.##")%">
                        </div>

                    </div>

                </div>

            </div>


            <!-- Location -->

            <div class="match-factor-card">

                <div class="match-factor-icon">

                    <i class="bi bi-geo-alt"></i>

                </div>


                <div class="match-factor-content">

                    <div class="match-factor-heading">

                        <div>

                            <h3>
                                Location
                            </h3>

                            <p>
                                @Model.LocationExplanation
                            </p>

                        </div>

                        <strong>
                            @Model.LocationScore.ToString("0.0")
                            /
                            @Model.LocationWeight.ToString("0.0")
                        </strong>

                    </div>


                    <div class="match-progress">

                        @{
                            decimal locationPercentage = 0;

                            if (Model.LocationWeight > 0)
                            {
                                locationPercentage =
                                    (Model.LocationScore /
                                    Model.LocationWeight) * 100;
                            }
                        }

                        <div class="match-progress-bar"
                             style="width:@locationPercentage.ToString("0.##")%">
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================================= -->
        <!-- SKILLS -->
        <!-- ============================================= -->

        <div class="row g-4 mt-2">

            <!-- Matched -->

            <div class="col-lg-6">

                <div class="career-card h-100">

                    <div class="career-card-header">

                        <span class="section-eyebrow">
                            STRENGTHS
                        </span>

                        <h2>
                            Matched skills
                        </h2>

                    </div>


                    @if (!Model.MatchedSkillNames.Any())
                    {
                        <p class="text-muted">
                            No required skills were matched.
                        </p>
                    }
                    else
                    {
                        <div class="match-skills-list">

                            @foreach (var skill in
                                Model.MatchedSkillNames)
                            {
                                <span class="match-skill matched">

                                    <i class="bi bi-check-circle"></i>

                                    @skill

                                </span>
                            }

                        </div>
                    }

                </div>

            </div>


            <!-- Missing -->

            <div class="col-lg-6">

                <div class="career-card h-100">

                    <div class="career-card-header">

                        <span class="section-eyebrow">
                            AREAS TO IMPROVE
                        </span>

                        <h2>
                            Missing skills
                        </h2>

                    </div>


                    @if (!Model.MissingSkillNames.Any())
                    {
                        <p class="text-success">

                            <i class="bi bi-check-circle me-1"></i>

                            You match all listed skills.

                        </p>
                    }
                    else
                    {
                        <div class="match-skills-list">

                            @foreach (var skill in
                                Model.MissingSkillNames)
                            {
                                <span class="match-skill missing">

                                    <i class="bi bi-x-circle"></i>

                                    @skill

                                </span>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ============================================= -->
        <!-- FOOTER ACTION -->
        <!-- ============================================= -->

        <div class="match-footer">

            <a asp-action="Details"
               asp-route-id="@Model.JobId"
               class="btn btn-primary">

                <i class="bi bi-arrow-left me-1"></i>

                Back to Job

            </a>

            <a asp-action="Index"
               class="btn btn-outline-primary">

                Find More Jobs

                <i class="bi bi-arrow-right ms-1"></i>

            </a>

        </div>

    </div>

</div>