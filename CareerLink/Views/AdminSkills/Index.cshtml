@model IEnumerable<CareerLink.ViewModels.AdminSkillListViewModel>

@{
    ViewData["Title"] = "Manage Skills";
}

<div class="cl-admin-page">

    <div class="cl-admin-page-header">

        <div>
            <div class="cl-admin-eyebrow">
                <i class="bi bi-stars"></i>
                SKILL MANAGEMENT
            </div>

            <h1 class="cl-admin-title">
                Manage Skills
            </h1>

            <p class="cl-admin-subtitle">
                Manage skills used by jobs and job seekers.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Admin"
               asp-action="Index"
               class="cl-soft-button">
                <i class="bi bi-arrow-left"></i>
                Dashboard
            </a>

            <a asp-controller="AdminSkills"
               asp-action="Create"
               class="cl-purple-button">
                <i class="bi bi-plus-lg"></i>
                Add Skill
            </a>

        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cl-profile-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="cl-admin-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="cl-admin-table-card">

        <div class="cl-admin-table-header">

            <div>
                <h2>Skill Catalogue</h2>
                <p>
                    @Model.Count() skill@(Model.Count() == 1 ? "" : "s") available.
                </p>
            </div>

            <div class="cl-admin-table-count">
                <i class="bi bi-stars"></i>
                @Model.Count()
            </div>

        </div>

        <div class="table-responsive">

            <table class="table cl-admin-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Skill</th>
                        <th>Jobs</th>
                        <th>Job Seekers</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var skill in Model)
                    {
                        <tr>

                            <td>
                                <div class="cl-admin-skill-cell">

                                    <div class="cl-admin-skill-icon">
                                        <i class="bi bi-stars"></i>
                                    </div>

                                    <strong>@skill.Name</strong>

                                </div>
                            </td>

                            <td>
                                <span class="cl-admin-number-badge">
                                    @skill.JobCount
                                </span>
                            </td>

                            <td>
                                <span class="cl-admin-number-badge">
                                    @skill.JobSeekerCount
                                </span>
                            </td>

                            <td class="text-end">

                                <div class="cl-admin-job-actions">

                                    <a asp-controller="AdminSkills"
                                       asp-action="Edit"
                                       asp-route-id="@skill.Id"
                                       class="cl-admin-outline-button">
                                        <i class="bi bi-pencil"></i>
                                        Edit
                                    </a>

                                    @if (skill.JobCount == 0 && skill.JobSeekerCount == 0)
                                    {
                                        <form asp-controller="AdminSkills"
                                              asp-action="Delete"
                                              asp-route-id="@skill.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this skill?');">

                                            <button type="submit"
                                                    class="cl-admin-danger-button">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="cl-admin-disabled-button"
                                                disabled
                                                title="This skill is currently in use.">
                                            <i class="bi bi-lock"></i>
                                            In Use
                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @if (!Model.Any())
        {
            <div class="cl-admin-empty-state">

                <div>
                    <i class="bi bi-stars"></i>
                </div>

                <h3>No skills found</h3>

                <p>
                    There are currently no skills in the CareerLink system.
                </p>

                <a asp-controller="AdminSkills"
                   asp-action="Create"
                   class="cl-purple-button">
                    <i class="bi bi-plus-lg"></i>
                    Add First Skill
                </a>

            </div>
        }

    </div>

</div>