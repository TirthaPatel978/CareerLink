@model CareerLink.ViewModels.AdminSkillFormViewModel

@{
    ViewData["Title"] = "Edit Skill";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="mb-1">Edit Skill</h1>
        <p class="text-muted mb-0">
            Update the skill name.
        </p>
    </div>

    <div class="row">

        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-body">

                    <form asp-controller="AdminSkills"
                          asp-action="Edit"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-controller="AdminSkills"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}