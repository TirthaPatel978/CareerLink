@model CareerLink.ViewModels.AdminSkillFormViewModel

@{
    ViewData["Title"] = "Edit Skill";
}

<div class="cl-admin-page">

    <div class="cl-admin-page-header">

        <div>
            <div class="cl-admin-eyebrow">
                <i class="bi bi-pencil-square"></i>
                SKILL MANAGEMENT
            </div>

            <h1 class="cl-admin-title">
                Edit Skill
            </h1>

            <p class="cl-admin-subtitle">
                Update the skill name.
            </p>
        </div>

        <a asp-controller="AdminSkills"
           asp-action="Index"
           class="cl-soft-button">
            <i class="bi bi-arrow-left"></i>
            Back to Skills
        </a>

    </div>

    <div class="cl-admin-form-grid">

        <div class="cl-admin-form-card">

            <div class="cl-admin-detail-card-header">

                <div class="cl-admin-detail-icon">
                    <i class="bi bi-pencil"></i>
                </div>

                <div>
                    <h2>Edit Skill</h2>
                    <p>Update the skill information.</p>
                </div>

            </div>

            <form asp-controller="AdminSkills"
                  asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="cl-profile-validation">
                </div>

                <div class="mb-4">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="cl-profile-form-footer">

                    <a asp-controller="AdminSkills"
                       asp-action="Index"
                       class="cl-soft-button">
                        Cancel
                    </a>

                    <button type="submit"
                            class="cl-purple-button">
                        <i class="bi bi-check-circle"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

        <div class="cl-admin-form-tip">

            <div class="cl-admin-tip-icon">
                <i class="bi bi-info-circle"></i>
            </div>

            <h3>Using Skills</h3>

            <p>
                A skill that is already associated with jobs or job seekers
                should be updated carefully so existing associations remain
                meaningful.
            </p>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}