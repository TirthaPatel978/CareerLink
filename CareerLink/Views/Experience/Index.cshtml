@model IEnumerable<CareerLink.ViewModels.ExperienceViewModel>

@{
    ViewData["Title"] = "My Experience";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">My Experience</h1>

            <p class="text-muted mb-0">
                Manage your professional work experience.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Experience
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4>No experience added yet</h4>

                <p class="text-muted">
                    Add your professional experience to strengthen your profile.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Add Your First Experience
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var experience in Model)
            {
                <div class="col-12">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                <div>

                                    <h4 class="mb-1">
                                        @experience.JobTitle
                                    </h4>

                                    <h6 class="text-primary">
                                        @experience.CompanyName
                                    </h6>

                                </div>

                                @if (experience.IsCurrent)
                                {
                                    <span class="badge bg-success align-self-start">
                                        Current
                                    </span>
                                }

                            </div>

                            <p class="text-muted mb-2">

                                @if (!string.IsNullOrWhiteSpace(experience.Location))
                                {
                                    <span>
                                        @experience.Location
                                        &nbsp;•&nbsp;
                                    </span>
                                }

                                @experience.StartDate.ToString("MMM yyyy")
                                -
                                @(experience.IsCurrent
                                    ? "Present"
                                    : experience.EndDate?.ToString("MMM yyyy"))

                            </p>

                            @if (!string.IsNullOrWhiteSpace(experience.Description))
                            {
                                <p>
                                    @experience.Description
                                </p>
                            }

                            <div class="d-flex gap-2">

                                <a asp-action="Edit"
                                   asp-route-id="@experience.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@experience.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>