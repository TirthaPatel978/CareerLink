@model IEnumerable<CareerLink.ViewModels.ExperienceViewModel>

@{
    ViewData["Title"] = "My Experience";
}

<div class="cl-experience-page">

    <!-- PAGE HEADER -->
    <section class="cl-experience-header">
        <div class="container">
            <div class="cl-experience-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-briefcase"></i>
                        Professional Profile
                    </div>

                    <h1>My Experience</h1>

                    <p>
                        Manage your professional work experience
                        and highlight your career journey.
                    </p>
                </div>

                <a asp-action="Create"
                   class="cl-experience-add-btn">
                    <i class="bi bi-plus-lg"></i>
                    Add Experience
                </a>

            </div>
        </div>
    </section>


    <!-- MAIN CONTENT -->
    <section class="cl-experience-main">
        <div class="container">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="cl-experience-success">

                    <div class="cl-experience-success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <div>
                        <strong>Experience updated</strong>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>

                    <button type="button"
                            class="btn-close ms-auto"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            @if (!Model.Any())
            {
                <!-- EMPTY STATE -->
                <div class="cl-experience-empty">

                    <div class="cl-experience-empty-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <div class="cl-small-label">
                        YOUR CAREER JOURNEY
                    </div>

                    <h2>No experience added yet</h2>

                    <p>
                        Add your professional experience to help employers
                        understand your background and career journey.
                    </p>

                    <a asp-action="Create"
                       class="cl-experience-primary-btn">
                        <i class="bi bi-plus-lg"></i>
                        Add Your First Experience
                    </a>

                </div>
            }
            else
            {
                <!-- SECTION HEADING -->
                <div class="cl-experience-section-heading">

                    <div>
                        <div class="cl-small-label">
                            WORK EXPERIENCE
                        </div>

                        <h2>Professional journey</h2>

                        <p>
                            Keep your work history accurate and up to date.
                        </p>
                    </div>

                    <div class="cl-experience-count">
                        <span>@Model.Count()</span>
                        <small>
                            @(Model.Count() == 1 ? "Position" : "Positions")
                        </small>
                    </div>

                </div>


                <!-- EXPERIENCE LIST -->
                <div class="cl-experience-list">

                    @foreach (var experience in Model)
                    {
                        <article class="cl-experience-card">

                            <div class="cl-experience-card-accent"></div>

                            <div class="cl-experience-card-content">

                                <div class="cl-experience-card-top">

                                    <div class="cl-experience-role">

                                        <div class="cl-experience-company-icon">
                                            <i class="bi bi-building"></i>
                                        </div>

                                        <div>
                                            <h3>
                                                @experience.JobTitle
                                            </h3>

                                            <div class="cl-experience-company">
                                                @experience.CompanyName
                                            </div>
                                        </div>

                                    </div>


                                    @if (experience.IsCurrent)
                                    {
                                        <span class="cl-experience-current">
                                            <span class="cl-experience-current-dot"></span>
                                            Current
                                        </span>
                                    }

                                </div>


                                <div class="cl-experience-meta">

                                    @if (!string.IsNullOrWhiteSpace(experience.Location))
                                    {
                                        <span>
                                            <i class="bi bi-geo-alt"></i>
                                            @experience.Location
                                        </span>
                                    }

                                    <span>
                                        <i class="bi bi-calendar3"></i>

                                        @experience.StartDate.ToString("MMM yyyy")

                                        <span class="cl-experience-meta-separator">
                                            —
                                        </span>

                                        @(experience.IsCurrent
                                            ? "Present"
                                            : experience.EndDate?.ToString("MMM yyyy"))
                                    </span>

                                </div>


                                @if (!string.IsNullOrWhiteSpace(experience.Description))
                                {
                                    <div class="cl-experience-description">
                                        <p>
                                            @experience.Description
                                        </p>
                                    </div>
                                }


                                <div class="cl-experience-card-footer">

                                    <div class="cl-experience-duration">
                                        <i class="bi bi-clock"></i>

                                        @(experience.IsCurrent
                                            ? "Currently working here"
                                            : "Previous position")
                                    </div>


                                    <div class="cl-experience-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@experience.Id"
                                           class="cl-experience-edit-btn">
                                            <i class="bi bi-pencil"></i>
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@experience.Id"
                                           class="cl-experience-delete-btn">
                                            <i class="bi bi-trash3"></i>
                                            Delete
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </article>
                    }

                </div>
            }

        </div>
    </section>

</div>