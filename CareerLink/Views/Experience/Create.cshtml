@model CareerLink.ViewModels.ExperienceViewModel

@{
    ViewData["Title"] = "Add Experience";
}

<div class="cl-experience-page">

    <!-- PAGE HEADER -->
    <section class="cl-experience-header">
        <div class="container">

            <div class="cl-experience-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-briefcase"></i>
                        Professional Profile
                    </div>

                    <h1>Add Experience</h1>

                    <p>
                        Add a professional position to your career history.
                    </p>
                </div>

                <a asp-action="Index"
                   class="cl-experience-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Experience
                </a>

            </div>

        </div>
    </section>


    <!-- FORM -->
    <section class="cl-experience-form-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-9 col-xl-8">

                    <div class="cl-experience-form-card">

                        <div class="cl-experience-form-heading">

                            <div class="cl-experience-form-icon">
                                <i class="bi bi-plus-lg"></i>
                            </div>

                            <div>
                                <div class="cl-small-label">
                                    NEW EXPERIENCE
                                </div>

                                <h2>Add a work experience</h2>

                                <p>
                                    Tell employers about a position,
                                    company and the work you performed.
                                </p>
                            </div>

                        </div>


                        <form asp-action="Create"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="cl-experience-validation">
                            </div>


                            <!-- JOB DETAILS -->
                            <div class="cl-experience-form-section-title">
                                <i class="bi bi-person-workspace"></i>
                                Position details
                            </div>

                            <div class="row g-4">

                                <div class="col-md-6">

                                    <div class="cl-experience-field">

                                        <label asp-for="JobTitle"
                                               class="cl-experience-label">
                                        </label>

                                        <input asp-for="JobTitle"
                                               class="cl-experience-input"
                                               placeholder="e.g. Software Developer" />

                                        <span asp-validation-for="JobTitle"
                                              class="cl-experience-error">
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="cl-experience-field">

                                        <label asp-for="CompanyName"
                                               class="cl-experience-label">
                                        </label>

                                        <input asp-for="CompanyName"
                                               class="cl-experience-input"
                                               placeholder="e.g. ABC Technologies" />

                                        <span asp-validation-for="CompanyName"
                                              class="cl-experience-error">
                                        </span>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <div class="cl-experience-field">

                                        <label asp-for="Location"
                                               class="cl-experience-label">
                                        </label>

                                        <div class="cl-experience-input-wrapper">

                                            <i class="bi bi-geo-alt"></i>

                                            <input asp-for="Location"
                                                   class="cl-experience-input cl-experience-input-with-icon"
                                                   placeholder="e.g. Ahmedabad, Gujarat" />

                                        </div>

                                        <span asp-validation-for="Location"
                                              class="cl-experience-error">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- DATES -->
                            <div class="cl-experience-form-section-title cl-experience-section-spaced">
                                <i class="bi bi-calendar3"></i>
                                Employment period
                            </div>

                            <div class="row g-4">

                                <div class="col-md-6">

                                    <div class="cl-experience-field">

                                        <label asp-for="StartDate"
                                               class="cl-experience-label">
                                        </label>

                                        <input asp-for="StartDate"
                                               type="date"
                                               class="cl-experience-input" />

                                        <span asp-validation-for="StartDate"
                                              class="cl-experience-error">
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="cl-experience-field">

                                        <label asp-for="EndDate"
                                               class="cl-experience-label">
                                        </label>

                                        <input asp-for="EndDate"
                                               type="date"
                                               class="cl-experience-input" />

                                        <span asp-validation-for="EndDate"
                                              class="cl-experience-error">
                                        </span>

                                        <div class="cl-experience-help">
                                            <i class="bi bi-info-circle"></i>
                                            Leave empty if you currently work here.
                                        </div>

                                    </div>

                                </div>


                                <div class="col-12">

                                    <label class="cl-experience-current-toggle">

                                        <input asp-for="IsCurrent"
                                               id="isCurrent" />

                                        <span class="cl-experience-toggle-box">
                                            <i class="bi bi-check"></i>
                                        </span>

                                        <span>
                                            <strong>Currently working here</strong>
                                            <small>
                                                Mark this position as your current job.
                                            </small>
                                        </span>

                                    </label>

                                </div>

                            </div>


                            <!-- DESCRIPTION -->
                            <div class="cl-experience-form-section-title cl-experience-section-spaced">
                                <i class="bi bi-card-text"></i>
                                Role description
                            </div>

                            <div class="cl-experience-field">

                                <label asp-for="Description"
                                       class="cl-experience-label">
                                </label>

                                <textarea asp-for="Description"
                                          class="cl-experience-textarea"
                                          rows="6"
                                          placeholder="Describe your responsibilities, achievements, projects and impact..."></textarea>

                                <span asp-validation-for="Description"
                                      class="cl-experience-error">
                                </span>

                                <div class="cl-experience-help">
                                    <i class="bi bi-lightbulb"></i>
                                    Focus on your responsibilities, achievements
                                    and the value you contributed.
                                </div>

                            </div>


                            <!-- FOOTER -->
                            <div class="cl-experience-form-footer">

                                <a asp-action="Index"
                                   class="cl-experience-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-experience-save-btn">
                                    <i class="bi bi-plus-lg"></i>
                                    Add Experience
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}