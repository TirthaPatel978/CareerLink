@model CareerLink.ViewModels.ExperienceViewModel

@{
    ViewData["Title"] = "Delete Experience";
}

<div class="cl-experience-page">

    <!-- PAGE HEADER -->
    <section class="cl-experience-header">
        <div class="container">

            <div class="cl-experience-header-content">

                <div>
                    <div class="cl-dashboard-eyebrow">
                        <i class="bi bi-briefcase"></i>
                        Professional Profile
                    </div>

                    <h1>Delete Experience</h1>

                    <p>
                        Review this experience before removing it
                        from your professional profile.
                    </p>
                </div>

                <a asp-action="Index"
                   class="cl-experience-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Experience
                </a>

            </div>

        </div>
    </section>


    <!-- DELETE CONFIRMATION -->
    <section class="cl-experience-form-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-7 col-xl-6">

                    <div class="cl-experience-delete-card">

                        <div class="cl-experience-delete-icon">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <div class="cl-small-label">
                            REMOVE EXPERIENCE
                        </div>

                        <h2>Are you sure?</h2>

                        <p class="cl-experience-delete-description">
                            This will permanently remove this position
                            from your professional profile.
                        </p>


                        <!-- EXPERIENCE SUMMARY -->
                        <div class="cl-experience-delete-summary">

                            <div class="cl-experience-delete-role">

                                <div class="cl-experience-delete-company-icon">
                                    <i class="bi bi-building"></i>
                                </div>

                                <div>
                                    <strong>
                                        @Model.JobTitle
                                    </strong>

                                    <span>
                                        @Model.CompanyName
                                    </span>
                                </div>

                            </div>


                            <div class="cl-experience-delete-details">

                                <div>
                                    <span>Location</span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(Model.Location)
                                            ? "Not specified"
                                            : Model.Location)
                                    </strong>
                                </div>

                                <div>
                                    <span>Duration</span>

                                    <strong>
                                        @Model.StartDate.ToString("MMM yyyy")
                                        —
                                        @(Model.IsCurrent
                                            ? "Present"
                                            : Model.EndDate?.ToString("MMM yyyy"))
                                    </strong>
                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div class="cl-experience-delete-description-box">

                                <span>Description</span>

                                <p>
                                    @Model.Description
                                </p>

                            </div>
                        }


                        <form asp-action="DeleteConfirmed"
                              method="post">

                            <input type="hidden"
                                   asp-for="Id" />

                            <div class="cl-experience-delete-footer">

                                <a asp-action="Index"
                                   class="cl-experience-cancel-btn">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="cl-experience-delete-confirm-btn">
                                    <i class="bi bi-trash3"></i>
                                    Delete Experience
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>