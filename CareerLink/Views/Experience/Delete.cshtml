@model CareerLink.ViewModels.ExperienceViewModel

@{
    ViewData["Title"] = "Delete Experience";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">

                <div class="card-body p-4">

                    <h1 class="fw-bold text-danger">
                        Delete Experience
                    </h1>

                    <p class="text-muted">
                        Are you sure you want to delete this experience?
                    </p>

                    <hr />

                    <dl class="row">

                        <dt class="col-sm-4">
                            Job Title
                        </dt>

                        <dd class="col-sm-8">
                            @Model.JobTitle
                        </dd>

                        <dt class="col-sm-4">
                            Company
                        </dt>

                        <dd class="col-sm-8">
                            @Model.CompanyName
                        </dd>

                        <dt class="col-sm-4">
                            Location
                        </dt>

                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Location)
                                ? "Not specified"
                                : Model.Location)
                        </dd>

                        <dt class="col-sm-4">
                            Duration
                        </dt>

                        <dd class="col-sm-8">
                            @Model.StartDate.ToString("MMM yyyy")
                            -
                            @(Model.IsCurrent
                                ? "Present"
                                : Model.EndDate?.ToString("MMM yyyy"))
                        </dd>

                    </dl>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <hr />

                        <h6>Description</h6>

                        <p>
                            @Model.Description
                        </p>
                    }

                    <form asp-action="DeleteConfirmed"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Experience
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>